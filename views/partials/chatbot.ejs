</div>

<!-- Ventana del Chat -->
<div class="ciasa-chat-window" id="ciasaChatWindow">
  <!-- Header -->
  <div class="ciasa-chat-header">
    <div class="ciasa-chat-header-info">
      <div>
        <div class="ciasa-chat-header-title">Smart Assistant</div>
        <div class="ciasa-chat-header-status">
          <span class="ciasa-online-dot"></span> Inteligencia Inmobiliaria RD
        </div>
      </div>
    </div>
    <button class="ciasa-chat-close-btn" onclick="toggleCiasaChat()" title="Cerrar chat">
      <i class="fa-solid fa-xmark"></i>
