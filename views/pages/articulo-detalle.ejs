<%- include('../layouts/header', { 
  pageTitle: article.seoTitle || (article.titulo + ' | CIASA Bolsa Inmobiliaria'), 
  pageDesc: article.seoDesc || article.extracto, 
  activePage: 'articulos' 
}) %>

  <style>
    /* Article Hero */
    .article-single-hero {
      background-image: <%= article.imagenGradiente || 'linear-gradient(135deg, rgba(10, 30, 54, 0.85), rgba(8, 145, 178, 0.65))' %>,
                        url('<%= article.imagen || "/assets/images/hero-dr.jpg" %>');
      background-size: cover;
      background-position: center;
      min-height: 420px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 90px 0 70px;
      text-align: center;
      color: #ffffff;
      position: relative;
    }
    .article-badge-cat {
      display: inline-block;
      padding: 6px 16px;
      border-radius: 50px;
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #ffffff;
      background: <%= article.categoriaColor || 'var(--green)' %>;
      margin-bottom: 18px;
    }
    .article-single-hero h1 {
      font-size: clamp(2rem, 4.2vw, 3.2rem);
      font-weight: 900;
      color: #ffffff;
      max-width: 920px;
      margin: 0 auto 18px;
      line-height: 1.2;
      letter-spacing: -0.5px;
    }
    .article-meta-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.9);
      flex-wrap: wrap;
    }

    /* Article Content Container */
    .article-wrapper {
      max-width: 820px;
      margin: -36px auto 80px;
      background: #ffffff;
      border-radius: 16px;
      box-shadow: 0 10px 35px rgba(10, 30, 54, 0.08);
      border: 1px solid var(--border);
      padding: 48px 56px;
      position: relative;
      z-index: 10;
    }

    .article-lead-excerpt {
      font-size: 1.05rem;
      line-height: 1.65;
      color: #334155;
      font-weight: 500;
      padding-bottom: 22px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    /* Estilos del Contenido Editor / HTML Calibrado */
    .article-body-content {
      font-size: 0.95rem;
      line-height: 1.75;
      color: #334155;
    }
    .article-body-content h2 {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--navy);
      margin: 32px 0 14px;
      letter-spacing: -0.2px;
      line-height: 1.3;
    }
    .article-body-content h3 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--navy);
      margin: 24px 0 10px;
      line-height: 1.35;
    }
    .article-body-content p {
      margin-bottom: 16px;
    }
    .article-body-content ul, .article-body-content ol {
      margin-bottom: 18px;
      padding-left: 24px;
    }
    .article-body-content li {
      margin-bottom: 8px;
    }
    .article-body-content strong {
      color: var(--navy);
      font-weight: 700;
    }
    .article-body-content blockquote {
      border-left: 4px solid var(--green);
      margin: 24px 0;
      padding: 14px 18px;
      background: #F8FAFC;
      border-radius: 0 8px 8px 0;
      font-style: italic;
      font-size: 0.98rem;
      color: var(--navy);
      line-height: 1.6;
    }
    .article-body-content img {
      max-width: 100%;
      height: auto;
      border-radius: 12px;
      margin: 28px 0;
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }
    .article-body-content iframe {
      width: 100%;
      aspect-ratio: 16/9;
      border-radius: 12px;
      margin: 28px 0;
      border: none;
    }

    /* Estilos Premium para Bloques CTA y Botones dentro de Artículos */
    .article-cta {
      background: linear-gradient(135deg, #0A1E36 0%, #142D47 100%);
      border-radius: 14px;
      padding: 36px 32px;
      margin: 40px 0 20px;
      color: #FFFFFF;
      text-align: center;
      box-shadow: 0 12px 30px rgba(10, 30, 54, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .article-cta h2, .article-cta h3 {
      color: #FFFFFF !important;
      font-size: 1.45rem !important;
      font-weight: 800 !important;
      margin: 0 0 10px !important;
    }
    .article-cta p {
      color: #CBD5E1 !important;
      font-size: 0.95rem !important;
      margin-bottom: 24px !important;
      max-width: 580px;
      margin-left: auto;
      margin-right: auto;
    }
    .cta-buttons {
      display: flex;
      gap: 14px;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
    }
    .cta-buttons a, .article-body-content a.cta-btn-primary, .article-body-content a.btn-gold {
      background: #7DB33A !important;
      color: #FFFFFF !important;
      font-weight: 800 !important;
      padding: 12px 24px !important;
      border-radius: 8px !important;
      text-decoration: none !important;
      font-size: 0.92rem !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 4px 14px rgba(125, 179, 58, 0.35) !important;
      transition: all 0.2s ease !important;
      border: none !important;
    }
    .cta-buttons a:hover, .article-body-content a.cta-btn-primary:hover, .article-body-content a.btn-gold:hover {
      background: #68992e !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(125, 179, 58, 0.45) !important;
    }
    .cta-buttons a.cta-btn-secondary, .cta-buttons a.btn-outline-white {
      background: transparent !important;
      color: #FFFFFF !important;
      border: 2px solid rgba(255, 255, 255, 0.8) !important;
      box-shadow: none !important;
    }
    .cta-buttons a.cta-btn-secondary:hover, .cta-buttons a.btn-outline-white:hover {
      background: rgba(255, 255, 255, 0.15) !important;
      border-color: #FFFFFF !important;
      transform: translateY(-2px);
    }
    /* Enlaces estándar dentro del contenido */
    .article-body-content a:not(.cta-btn-primary):not(.btn-gold):not(.cta-btn-secondary):not(.btn-outline-white) {
      color: #2563EB;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 0.15s ease;
    }
    .article-body-content a:not(.cta-btn-primary):not(.btn-gold):not(.cta-btn-secondary):not(.btn-outline-white):hover {
      color: #1D4ED8;
    }

    @media (max-width: 768px) {
      .article-wrapper {
        padding: 32px 20px;
        margin-top: -20px;
        border-radius: 12px;
      }
      .article-single-hero {
        min-height: 320px;
        padding: 60px 16px 40px;
      }
    }
  </style>

  <!-- Hero Header -->
  <section class="article-single-hero">
    <div class="container">
      <span class="article-badge-cat"><%= article.categoriaNombre || article.categoria %></span>
      <h1><%= article.titulo %></h1>
      <div class="article-meta-bar">
        <span><i class="fa-solid fa-user-pen" style="color: var(--green);"></i> <%= article.autor || 'Equipo CIASA' %></span>
        <span><i class="fa-regular fa-calendar"></i> <%= article.fechaPublicacion || 'Reciente' %></span>
        <span><i class="fa-regular fa-clock"></i> <%= article.tiempoLectura || '7 min de lectura' %></span>
      </div>
    </div>
  </section>

  <main style="background: var(--bg); padding-bottom: 40px;">
    <div class="container">
      <div class="article-wrapper">
        
        <!-- Extracto destacado -->
        <% if (article.extracto) { %>
          <div class="article-lead-excerpt">
            <%= article.extracto %>
          </div>
        <% } %>

        <!-- Contenido principal enriquecido -->
        <div class="article-body-content">
          <%- article.contenido %>
        </div>

        <!-- Botones de Compartir & Regreso -->
        <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 32px; margin-top: 48px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 16px;">
          <a href="/articulos" class="btn-secondary" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--navy); text-decoration: none; padding: 10px 20px; border: 1px solid var(--border); border-radius: 8px;">
            <i class="fa-solid fa-arrow-left"></i> Todos los Artículos
          </a>

          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 0.85rem; font-weight: 700; color: #64748B;">Compartir:</span>
            <a href="https://wa.me/?text=<%= encodeURIComponent(article.titulo + ' https://ciasard.com/articulos/' + article.slug) %>" target="_blank" style="width: 36px; height: 36px; border-radius: 50%; background: #25D366; color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none;" title="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent('https://ciasard.com/articulos/' + article.slug) %>" target="_blank" style="width: 36px; height: 36px; border-radius: 50%; background: #0A66C2; color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none;" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- CTA Asesoría Personalizada -->
  <section class="section-pad" style="background: var(--navy); color: #ffffff; text-align: center; padding: 64px 20px;">
    <div class="container-narrow">
      <h2 style="font-size: clamp(1.8rem, 3.2vw, 2.3rem); font-weight: 800; margin-bottom: 14px; color: #ffffff;">
        ¿Deseas invertir con el respaldo de CIASA?
      </h2>
      <p style="font-size: 1.05rem; color: rgba(255, 255, 255, 0.85); max-width: 540px; margin: 0 auto 30px; line-height: 1.6;">
        Accede a proyectos turísticos con exención fiscal CONFOTUR y administración remota llave en mano.
      </p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/proyectos" style="background: var(--green); color: #ffffff; padding: 12px 28px; border-radius: 8px; font-weight: 700; text-decoration: none; box-shadow: 0 4px 14px rgba(125, 179, 58, 0.35);">
          Explorar Proyectos
        </a>
        <a href="/contacto" style="background: transparent; color: #ffffff; border: 2px solid rgba(255, 255, 255, 0.7); padding: 12px 28px; border-radius: 8px; font-weight: 700; text-decoration: none;">
          Hablar con un Asesor
        </a>
      </div>
    </div>
  </section>

<%- include('../layouts/footer') %>
