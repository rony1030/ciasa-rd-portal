      min-width: 220px;
    }
    .popup-box h4 {
      font-size: 1.1rem;
      font-weight: 800;
      color: #0A1E36;
      margin: 0 0 4px;
    }
    .popup-box p {
      font-size: 0.82rem;
      color: #64748B;
      line-height: 1.4;
      margin: 0 0 12px;
    }
  </style>

  <!-- Hero Section -->
  <section class="map-page-hero">
    <div class="container">
      <h1>Mapa Interactivo & Proyectos</h1>
      <p>Selecciona una región en el mapa para explorar oportunidades o utiliza los filtros para encontrar tu propiedad ideal en República Dominicana.</p>
    </div>
  </section>

  <!-- Map & Projects Section -->
  <section class="map-wrapper-section">
    <div class="container">
      
      <!-- 1. MAPA SUPERIOR PANORÁMICO LIMPIO -->
      <div class="map-top-card">
        <div id="interactiveMap"></div>
      </div>

      <!-- 2. BARRA DE FILTROS INFERIOR REDISEÑADA -->
      <div class="map-filter-bar">
        <div class="filter-grid">
          <div class="form-group">
            <label><i class="fa-solid fa-magnifying-glass" style="color: #64748B;"></i> Buscar Proyecto</label>
            <input type="text" id="searchInput" class="form-control-input" placeholder="Nombre, ubicación o código..." oninput="applyAllFilters()">
          </div>
          <!-- Dropdown Personalizado de Región -->
          <div class="form-group">
            <label><i class="fa-solid fa-location-dot" style="color: #64748B;"></i> Región / Polo</label>
            <div class="custom-dropdown-wrap" id="regionDropdownWrap">
              <div class="custom-dropdown-trigger" onclick="toggleCustomDropdown('regionDropdownWrap')">
                <span id="regionSelectedLabel">Todas las Regiones</span>
                <i class="fa-solid fa-chevron-down chevron-icon"></i>
              </div>
              <div class="custom-dropdown-menu" id="regionDropdownMenu">
                <div class="custom-dropdown-item selected" onclick="selectRegionOption('all', 'Todas las Regiones')">
                  <span>Todas las Regiones</span>
                  <span class="badge-count" id="badgeAllRegions">27</span>
                </div>
              </div>
              <input type="hidden" id="regionSelect" value="all">
            </div>
          </div>

          <!-- Dropdown Personalizado de Presupuesto -->
          <div class="form-group">
            <label><i class="fa-solid fa-dollar-sign" style="color: #64748B;"></i> Presupuesto Máx.</label>
            <div class="custom-dropdown-wrap" id="budgetDropdownWrap">
              <div class="custom-dropdown-trigger" onclick="toggleCustomDropdown('budgetDropdownWrap')">
                <span id="budgetSelectedLabel">Sin límite</span>
                <i class="fa-solid fa-chevron-down chevron-icon"></i>
              </div>
              <div class="custom-dropdown-menu" id="budgetDropdownMenu">
                <div class="custom-dropdown-item selected" onclick="selectBudgetOption('all', 'Sin límite')">
                  <span>Sin límite</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectBudgetOption('150000', 'Hasta $150,000 USD')">
                  <span>Hasta $150,000 USD</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectBudgetOption('250000', 'Hasta $250,000 USD')">
                  <span>Hasta $250,000 USD</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectBudgetOption('400000', 'Hasta $400,000 USD')">
                  <span>Hasta $400,000 USD</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectBudgetOption('600000', 'Hasta $600,000 USD')">
                  <span>Hasta $600,000 USD</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectBudgetOption('1000000', 'Hasta $1,000,000 USD')">
                  <span>Hasta $1,000,000 USD</span>
                </div>
              </div>
              <input type="hidden" id="budgetSelect" value="all">
            </div>
          </div>
          <div class="form-group">
            <label class="confotur-pill-filter">
              <input type="checkbox" id="confoturCheckbox" onchange="applyAllFilters()">
              <span><i class="fa-solid fa-shield-halved" style="color: #16A34A;"></i> CONFOTUR</span>
            </label>
          </div>
          <div class="form-group">
            <button class="btn-reset-filters" onclick="resetFilters()">
              <i class="fa-solid fa-rotate-left"></i> Limpiar
            </button>
          </div>
        </div>
      </div>

      <!-- Resumen del Estado de Filtro -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--navy); display: flex; align-items: center; gap: 10px;" id="resultsHeading">
          Mostrando Proyectos Disponibles
        </h3>
        <div style="font-size: 0.92rem; font-weight: 700; color: #64748B; background: #FFFFFF; border: 1px solid #E2E8F0; padding: 6px 14px; border-radius: 50px;" id="projectsCountLabel">
          Cargando proyectos...
        </div>
      </div>

      <!-- 3. GRILLA DE PROYECTOS FILTRADOS -->
      <div class="projects-grid" id="projectsGrid">
        <!-- Renderizado dinámico vía JavaScript -->
      </div>

      <div id="noResults" style="display: none; text-align: center; padding: 60px 20px; background: #ffffff; border-radius: 20px; border: 1px solid var(--border); box-shadow: 0 4px 18px rgba(0,0,0,0.04);">
        <i class="fa-solid fa-building-circle-xmark" style="font-size: 3rem; color: #94A3B8; margin-bottom: 16px;"></i>
        <h4 style="font-size: 1.3rem; font-weight: 800; color: var(--navy); margin-bottom: 8px;">No encontramos proyectos con esos filtros</h4>
        <p style="color: #64748B; font-size: 0.95rem; margin-bottom: 20px;">Intenta ajustar tu búsqueda o restablecer los filtros para ver todo el inventario disponible.</p>
        <button class="btn-cta" onclick="resetFilters()" style="background: var(--green); padding: 12px 24px;">Ver Todos los Proyectos</button>
      </div>

    </div>
  </section>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <script>
    const DYNAMIC_REGIONS = <%- JSON.stringify(typeof dynamicRegions !== 'undefined' ? dynamicRegions : []) %>;
    const ALL_PROJECTS = <%- JSON.stringify(typeof projects !== 'undefined' ? projects : []) %>;

    // Diccionario de nombres elegantes para las zonas
    const REGION_DISPLAY_NAMES = {
      'punta-cana': 'Punta Cana & Cap Cana',
      'bayahibe': 'Bayahíbe & Dominicus',
      'juan-dolio': 'Juan Dolio / San Pedro',
      'distrito-nacional': 'Santo Domingo & DN',
      'bani': 'Baní / Peravia',
      'miches': 'Miches / El Seibo'
    };

    let currentSelectedRegion = 'all';
    let regionMarkers = {};

    // 1. Inicializar Mapa Fijado Exclusivamente a República Dominicana
    const RD_BOUNDS = [
      [17.45, -72.10], // Suroeste (Pedernales / Límite Marítimo Sur)
      [20.10, -68.20]  // Noreste (Punta Cana / Samaná / Océano Atlántico Norte)
    ];

    const map = L.map('interactiveMap', {
      center: [18.75, -69.65],
      zoom: 8.5,
      minZoom: 8,
      maxZoom: 18,
      maxBounds: RD_BOUNDS,
      maxBoundsViscosity: 1.0, // Impide arrastrar el mapa fuera de República Dominicana
      zoomControl: true,
      scrollWheelZoom: false
    });

    map.fitBounds(RD_BOUNDS, { padding: [10, 10] });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19
    }).addTo(map);

    // 2. Control de Dropdowns Modernos Personalizados
    function toggleCustomDropdown(wrapId) {
      const wrap = document.getElementById(wrapId);
      const isOpen = wrap.classList.contains('active');
      closeAllCustomDropdowns();
      if (!isOpen) {
        wrap.classList.add('active');
      }
    }

    function closeAllCustomDropdowns() {
      document.querySelectorAll('.custom-dropdown-wrap').forEach(w => w.classList.remove('active'));
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.custom-dropdown-wrap')) {
        closeAllCustomDropdowns();
      }
    });

    function selectRegionOption(regId, label) {
      document.getElementById('regionSelect').value = regId;
      document.getElementById('regionSelectedLabel').innerText = label;
      
      document.querySelectorAll('#regionDropdownMenu .custom-dropdown-item').forEach(item => {
        item.classList.toggle('selected', item.getAttribute('data-val') === regId);
      });
      
      closeAllCustomDropdowns();
      onRegionSelectChange(regId);
    }

    function selectBudgetOption(val, label) {
      document.getElementById('budgetSelect').value = val;
      document.getElementById('budgetSelectedLabel').innerText = label;

      document.querySelectorAll('#budgetDropdownMenu .custom-dropdown-item').forEach(item => {
        item.classList.toggle('selected', item.getAttribute('data-val') === val);
      });

      closeAllCustomDropdowns();
      applyAllFilters();
    }

    // Inicializar Opciones de Región en el Menú Personalizado
    const regionMenu = document.getElementById('regionDropdownMenu');
    document.getElementById('badgeAllRegions').innerText = ALL_PROJECTS.length;

    DYNAMIC_REGIONS.forEach(region => {
      const regProjects = ALL_PROJECTS.filter(p => matchRegion(p, region.id));
      const count = regProjects.length;

      // Item en Dropdown Custom
      const item = document.createElement('div');
      item.className = 'custom-dropdown-item';
      item.setAttribute('data-val', region.id);
      item.onclick = () => selectRegionOption(region.id, `${region.name}`);
      item.innerHTML = `
        <span>${region.name}</span>
        <span class="badge-count">${count}</span>
      `;
      regionMenu.appendChild(item);

      // Marcador de Polo en el Mapa con número de proyectos
      const pinIcon = L.divIcon({
        className: 'custom-map-pin-container',
        html: `<div class="custom-map-pin" id="pin-${region.id}" style="width: 36px; height: 36px;">${count}</div>`,
        iconSize: [36, 36],
        iconAnchor: [18, 18]
      });

      const marker = L.marker(region.coords, { icon: pinIcon }).addTo(map);
      
      marker.bindPopup(`
        <div class="popup-box">
          <h4>${region.name}</h4>
          <p>${region.desc || region.description || ''}</p>
          <div style="font-size: 0.82rem; font-weight: 800; color: var(--green); margin-bottom: 8px;">${count} Proyectos Disponibles</div>
          <button onclick="selectRegionFilter('${region.id}')" style="width: 100%; background: var(--navy); color: #ffffff; border: none; padding: 8px 14px; border-radius: 8px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">
            Filtrar proyectos de esta zona
          </button>
        </div>
      `, { maxWidth: 280 });

      marker.on('click', () => {
        selectRegionFilter(region.id);
      });

      regionMarkers[region.id] = { marker, region };
    });

    // 3. Helper de Matching de Región y Nombre Limpio
    function getCleanRegionName(rawRegion) {
      if (!rawRegion) return 'República Dominicana';
      const key = rawRegion.toLowerCase();
      for (const [slug, name] of Object.entries(REGION_DISPLAY_NAMES)) {
        if (key.includes(slug) || slug.includes(key)) return name;
      }
      if (key.includes('santo domingo') || key.includes('distrito')) return 'Santo Domingo & DN';
      return rawRegion.charAt(0).toUpperCase() + rawRegion.slice(1);
    }

    function matchRegion(proj, regionId) {
      if (!regionId || regionId === 'all') return true;
      const reg = (proj.region || proj.polo || '').toLowerCase();
      const target = regionId.toLowerCase().replace(/-/g, ' ');
      return reg.includes(regionId.toLowerCase()) || reg.includes(target) || (regionId === 'distrito-nacional' && (reg.includes('santo domingo') || reg.includes('distrito')));
    }

    // 4. Selección de Región Bidireccional
    function selectRegionFilter(regionId) {
      currentSelectedRegion = regionId;
      regionSelect.value = regionId;

      // Actualizar pines en mapa
      document.querySelectorAll('.custom-map-pin').forEach(p => p.classList.remove('active-pin'));
      if (regionId !== 'all' && regionMarkers[regionId]) {
        const pinEl = document.getElementById(`pin-${regionId}`);
        if (pinEl) pinEl.classList.add('active-pin');
        map.flyTo(regionMarkers[regionId].region.coords, regionMarkers[regionId].region.zoom, { duration: 1.0 });
      } else {
        map.fitBounds(RD_BOUNDS, { padding: [10, 10], duration: 1.0 });
      }

      applyAllFilters();
    }

    function onRegionSelectChange(val) {
      selectRegionFilter(val);
    }

    // 5. Aplicar Filtros Combinados y Renderizar Tarjetas
    function applyAllFilters() {
      const searchVal = document.getElementById('searchInput').value.toLowerCase().trim();
      const regionVal = currentSelectedRegion;
      const budgetVal = document.getElementById('budgetSelect').value;
      const confoturVal = document.getElementById('confoturCheckbox').checked;

      const filtered = ALL_PROJECTS.filter(p => {
        // Filtro por texto
        const matchSearch = !searchVal || 
          (p.name && p.name.toLowerCase().includes(searchVal)) ||
          (p.code && p.code.toLowerCase().includes(searchVal)) ||
          (p.location && p.location.toLowerCase().includes(searchVal)) ||
          (p.subLocation && p.subLocation.toLowerCase().includes(searchVal)) ||
          (p.region && p.region.toLowerCase().includes(searchVal));

        // Filtro por región
        const matchReg = matchRegion(p, regionVal);

        // Filtro por presupuesto
        let matchBudget = true;
        if (budgetVal !== 'all') {
          const maxB = parseFloat(budgetVal);
          const price = p.priceFrom || 0;
          matchBudget = price > 0 && price <= maxB;
        }

        // Filtro por CONFOTUR
        const matchConfotur = !confoturVal || (p.confotur === true || p.taxIncentive === true);

        return matchSearch && matchReg && matchBudget && matchConfotur;
      });

      renderProjectsGrid(filtered);
    }

    // 6. Renderizar Grilla de Proyectos con Habitaciones, Tamaño y Precio
    function renderProjectsGrid(projects) {
      const grid = document.getElementById('projectsGrid');
      const noRes = document.getElementById('noResults');
      const countLabel = document.getElementById('projectsCountLabel');
      const heading = document.getElementById('resultsHeading');

      grid.innerHTML = '';

      if (currentSelectedRegion === 'all') {
        heading.innerHTML = 'Mostrando Proyectos en Todo el País';
      } else {
        const regObj = DYNAMIC_REGIONS.find(r => r.id === currentSelectedRegion);
        const name = regObj ? regObj.name : getCleanRegionName(currentSelectedRegion);
        heading.innerHTML = `Proyectos en ${name}`;
      }

      countLabel.innerText = `${projects.length} ${projects.length === 1 ? 'proyecto disponible' : 'proyectos disponibles'}`;

      if (projects.length === 0) {
        noRes.style.display = 'block';
        return;
      }
      noRes.style.display = 'none';

      projects.forEach(p => {
        const card = document.createElement('a');
        card.href = `/proyectos/${p.slug || p.id}`;
        card.className = 'project-card';
        card.id = `card-proj-${p.slug || p.id}`;

        const imgUrl = p.coverImage || p.image || '/assets/images/flyers/pictures/Coastal_development_at_202604231822_2.jpeg';
        const priceFmt = p.priceFrom ? `$${p.priceFrom.toLocaleString('en-US')}` : '$180,000';
        const cleanRegion = getCleanRegionName(p.region || p.location);
        
        // Habitaciones, Baños y Metraje (Estilo Altnest)
        const beds = p.bedrooms ? p.bedrooms : (p.rooms || '2');
        const baths = p.bathrooms ? p.bathrooms : (p.baths || '2');
        const size = p.sizeFrom ? `${p.sizeFrom} M²` : '120 M²';

        card.innerHTML = `
          <div class="project-card-media" style="background-image: url('${imgUrl}');">
            <span class="card-badge-region"><i class="fa-solid fa-location-dot"></i> ${cleanRegion}</span>
            ${p.confotur ? `<span class="card-badge-confotur"><i class="fa-solid fa-shield-halved"></i> CONFOTUR</span>` : ''}
          </div>
          <div class="project-card-body">
            <div class="project-header-row">
              <h3 class="project-card-title">${p.name}</h3>
              <div class="project-card-price">${priceFmt}</div>
            </div>
            
            <div class="project-location-line">
              <i class="fa-solid fa-location-dot"></i>
              <span>${p.subLocation ? p.subLocation + ', ' + cleanRegion : cleanRegion}, República Dominicana</span>
            </div>
            
            <div class="project-specs-strip">
              <div class="spec-item"><i class="fa-solid fa-bed"></i> ${beds} BEDS</div>
              <div class="spec-item"><i class="fa-solid fa-bath"></i> ${baths} BATHS</div>
              <div class="spec-item"><i class="fa-solid fa-vector-square"></i> ${size}</div>
              ${p.roi ? `<span class="roi-pill-altnest">${p.roi}</span>` : ''}
            </div>
          </div>
        `;

        grid.appendChild(card);
      });
    }

    // 7. Resetear Filtros
    function resetFilters() {
      document.getElementById('searchInput').value = '';
      document.getElementById('budgetSelect').value = 'all';
      document.getElementById('confoturCheckbox').checked = false;
      selectRegionFilter('all');
    }

    // Ejecutar render inicial
    applyAllFilters();
  </script>

<%- include('../layouts/footer') %>

