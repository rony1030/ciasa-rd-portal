      }
    }
    .project-card:hover .project-card-title {
      color: var(--green);
    }
    .project-card-price {
      font-size: 1.22rem;
      font-weight: 900;
      color: #0A1E36;
      white-space: nowrap;
      letter-spacing: -0.3px;
      line-height: 1.2;
      flex-shrink: 0;
    }
    @media (max-width: 480px) {
      .project-card-price {
        font-size: 1.1rem;
      }
    }
    
    .project-location-line {
      font-size: 0.84rem;
      color: #64748B;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 14px;
      font-weight: 500;
      line-height: 1.35;
    }
    .project-location-line i {
      color: #94A3B8;
      font-size: 0.88rem;
      flex-shrink: 0;
    }

    /* Altnest Specs Strip */
    .project-specs-strip {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding-top: 12px;
      border-top: 1px solid #F1F5F9;
      margin-top: auto;
      font-size: 0.8rem;
      font-weight: 700;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    @media (max-width: 480px) {
      .project-specs-strip {
        gap: 8px;
        font-size: 0.76rem;
      }
    }
    .spec-item {
      display: flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }
    .spec-item i {
      color: #64748B;
      font-size: 0.88rem;
    }
    .roi-pill-altnest {
      margin-left: auto;
      background: #EFF6FF;
      color: #2563EB;
      border: 1px solid #DBEAFE;
      font-size: 0.74rem;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 6px;
      white-space: nowrap;
    }

    /* Custom Leaflet Marker Styling */
    .custom-map-pin {
      background: var(--navy);
      border: 2.5px solid #ffffff;
      border-radius: 50%;
      color: #ffffff;
      font-weight: 800;
      font-size: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 16px rgba(10,30,54,0.35);
      cursor: pointer;
      transition: all 0.25s ease;
    }
    .custom-map-pin.active-pin {
      background: var(--green) !important;
      transform: scale(1.3);
      box-shadow: 0 8px 22px rgba(125, 179, 58, 0.6);
    }

    /* Popup Styling */
    .leaflet-popup-content-wrapper {
      border-radius: 16px;
      box-shadow: 0 14px 36px rgba(10,30,54,0.2);
      padding: 8px;
    }
