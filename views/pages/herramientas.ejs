  <script>
    function switchCalc(calcId, btn) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.calculator-card').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('calc-' + calcId).classList.add('active');
    }

    function formatUsd(num) {
      return '$' + Math.round(num).toLocaleString('en-US') + ' USD';
    }

    function updateRoi() {
      const price = parseFloat(document.getElementById('roiPrice').value);
      const adr = parseFloat(document.getElementById('roiAdr').value);
      const occ = parseFloat(document.getElementById('roiOcc').value) / 100;
      const expPercent = parseFloat(document.getElementById('roiExp').value) / 100;

      const nights = Math.round(365 * occ);
      document.getElementById('roiPriceVal').innerText = formatUsd(price);
      document.getElementById('roiAdrVal').innerText = '$' + adr + ' / noche';
      document.getElementById('roiOccVal').innerText = Math.round(occ * 100) + '% (' + nights + ' noches)';
      document.getElementById('roiExpVal').innerText = Math.round(expPercent * 100) + '% del ingreso';

      const gross = nights * adr;
      const expenses = gross * expPercent;
      const net = gross - expenses;
      const roi = (net / price) * 100;

      document.getElementById('roiGross').innerText = formatUsd(gross);
      document.getElementById('roiExpenses').innerText = formatUsd(expenses);
      document.getElementById('roiNet').innerText = formatUsd(net);
      document.getElementById('roiPercent').innerText = roi.toFixed(1) + '%';
    }

    function updateMortgageRate() {
      updateMortgage();
    }

    function updateMortgage() {
      const propVal = parseFloat(document.getElementById('mortProp').value);
      const downPercent = parseFloat(document.getElementById('mortDown').value) / 100;
      const years = parseInt(document.getElementById('mortYears').value);
      const rateAnnual = parseFloat(document.getElementById('mortRateSelect').value) / 100;

      const downAmount = propVal * downPercent;
      const loanAmount = propVal - downAmount;
      const months = years * 12;
      const monthlyRate = rateAnnual / 12;

      document.getElementById('mortPropVal').innerText = formatUsd(propVal);
      document.getElementById('mortDownVal').innerText = Math.round(downPercent * 100) + '% (' + formatUsd(downAmount) + ')';
      document.getElementById('mortYearsVal').innerText = years + ' Años (' + months + ' meses)';

      // Monthly payment formula: M = P [ r(1 + r)^n ] / [ (1 + r)^n – 1]
      const monthlyPayment = (loanAmount * (monthlyRate * Math.pow(1 + monthlyRate, months))) / (Math.pow(1 + monthlyRate, months) - 1);
      const totalPaid = monthlyPayment * months;
      const totalInterest = totalPaid - loanAmount;

      document.getElementById('mortLoanAmount').innerText = formatUsd(loanAmount);
      document.getElementById('mortDownAmount').innerText = formatUsd(downAmount);
      document.getElementById('mortTotalInterest').innerText = formatUsd(totalInterest);
      document.getElementById('mortMonthly').innerText = '$' + Math.round(monthlyPayment).toLocaleString('en-US') + ' / mes';
    }

    function updateConfotur() {
      const price = parseFloat(document.getElementById('confPrice').value);
      const years = parseInt(document.getElementById('confYears').value);

      document.getElementById('confPriceVal').innerText = formatUsd(price);
      document.getElementById('confYearsVal').innerText = years + ' Años';

      const transferSavings = price * 0.03;
      const ipiSavings = price * 0.01 * years;
      const totalSavings = transferSavings + ipiSavings;

      document.getElementById('confTransfer').innerText = formatUsd(transferSavings);
      document.getElementById('confIpi').innerText = formatUsd(ipiSavings);
      document.getElementById('confTotal').innerText = formatUsd(totalSavings);
    }

    // Initialize all calculators
    updateRoi();
    updateMortgage();
    updateConfotur();
  </script>

