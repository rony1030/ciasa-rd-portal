          <div class="faq-item-box" style="background: #ffffff; border: 1px solid #E2E8F0; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
            <button type="button" class="faq-trigger-btn" onclick="toggleFaqAccordion(this)" style="width: 100%; text-align: left; padding: 20px 24px; background: none; border: none; font-size: 1.05rem; font-weight: 700; color: var(--navy); display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-family: inherit;">
