<%- include('../layouts/header', { pageTitle: 'Catálogo de Proyectos Inmobiliarios | CIASA Bolsa Inmobiliaria', pageDesc: 'Explora nuestros 27 proyectos turísticos y residenciales en República Dominicana con Ley CONFOTUR, alta plusvalía y retorno en USD.', activePage: 'proyectos' }) %>

  <style>
    .portfolio-hero {
      background-image: linear-gradient(135deg, rgba(10, 30, 54, 0.85), rgba(8, 145, 178, 0.65)),
                        url('/assets/images/flyers/pictures/Coastal_development_at_202604231822_2.jpeg');
      background-size: cover;
      background-position: center;
      min-height: 360px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 90px 0 80px;
      text-align: center;
      color: #ffffff;
    }
    .portfolio-hero h1 {
      font-size: clamp(2.3rem, 4vw, 3.2rem);
      font-weight: 900;
      color: #ffffff;
      margin-bottom: 12px;
      line-height: 1.15;
    }
    .portfolio-hero p {
      font-size: 1.15rem;
      color: rgba(255, 255, 255, 0.9);
      max-width: 660px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Filter Bar Responsive */
    .filter-bar-container {
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
      margin: -36px auto 45px;
      position: relative;
      z-index: 10;
      width: 100%;
    }
    @media (max-width: 768px) {
      .filter-bar-container {
        margin: -24px auto 35px;
        padding: 18px 16px;
        border-radius: 14px;
      }
    }
    .filter-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr auto;
      gap: 16px;
      align-items: flex-end;
    }
    @media (max-width: 991px) {
      .filter-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    @media (max-width: 580px) {
      .filter-grid {
        grid-template-columns: 1fr;
      }
    }

    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--navy);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }
    .form-control-select, .form-control-input {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid #CBD5E1;
      border-radius: 8px;
      font-size: 0.92rem;
      font-family: inherit;
      color: #334155;
      background: #F8FAFC;
    }

    .confotur-toggle-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      height: 42px;
      cursor: pointer;
    }
    .confotur-toggle-wrap input {
      accent-color: var(--green);
      width: 18px;
      height: 18px;
      cursor: pointer;
    }
    .confotur-toggle-label {
      font-size: 0.88rem;
      font-weight: 700;
      color: #065F46;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* Projects Grid Altnest Minimalist Style (Centrado y balanceado) */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
      gap: 28px;
      margin-bottom: 80px;
      width: 100%;
    }
    @media (max-width: 640px) {
      .projects-grid {
        grid-template-columns: 1fr;
        gap: 20px;
        margin-bottom: 50px;
      }
    }

    .project-card {
      background: #ffffff;
      border: 1px solid #E2E8F0;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(10, 30, 54, 0.05);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
      width: 100%;
    }
    @media (max-width: 640px) {
      .project-card {
        border-radius: 16px;
      }
    }
    .project-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 36px rgba(10, 30, 54, 0.12);
      border-color: #CBD5E1;
    }

    .project-card-media {
      height: 240px;
      position: relative;
      background-size: cover;
      background-position: center;
      background-color: #0A1E36;
      overflow: hidden;
    }
    .project-card-media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(10, 30, 54, 0.45) 0%, transparent 60%);
      pointer-events: none;
    }
    .card-badge-region {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(10, 30, 54, 0.85);
      backdrop-filter: blur(8px);
      color: #ffffff;
      padding: 5px 12px;
      border-radius: 50px;
      font-size: 0.76rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      z-index: 2;
      box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }
    .card-badge-confotur {
      position: absolute;
      top: 14px;
      right: 14px;
      background: #ECFDF5;
      color: #059669;
      border: 1px solid #A7F3D0;
      padding: 5px 12px;
      border-radius: 50px;
      font-size: 0.76rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      z-index: 2;
      box-shadow: 0 4px 10px rgba(0,0,0,0.06);
    }

    .project-card-body {
      padding: 22px 24px;
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #ffffff;
    }
    @media (max-width: 480px) {
      .project-card-body {
        padding: 16px 16px;
      }
    }
    
    /* Altnest Top Row: Title + Price Horizontal Alignment */
    .project-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 8px;
    }
    .project-card-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: #0A1E36;
      margin: 0;
      line-height: 1.25;
      text-transform: uppercase;
      letter-spacing: -0.2px;
      transition: color 0.2s ease;
      flex: 1;
      word-break: break-word;
    }
    @media (max-width: 480px) {
      .project-card-title {
        font-size: 1.02rem;
      }
    }
    .project-card:hover .project-card-title {
      color: var(--green);
    }
    .project-card-price {
      font-size: 1.22rem;
      font-weight: 900;
      color: #0A1E36;
      white-space: nowrap;
      letter-spacing: -0.3px;
      line-height: 1.2;
      flex-shrink: 0;
    }
    @media (max-width: 480px) {
      .project-card-price {
        font-size: 1.1rem;
      }
    }
    .project-card-price small {
      font-size: 0.72rem;
      font-weight: 700;
      color: #64748B;
      text-transform: uppercase;
    }

    /* Altnest Location Line */
    .project-location-line {
      font-size: 0.84rem;
      color: #64748B;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 14px;
      font-weight: 500;
      line-height: 1.35;
    }
    .project-location-line i {
      color: #94A3B8;
      font-size: 0.88rem;
      flex-shrink: 0;
    }

    /* Altnest Specs Strip: Beds, Baths, Sqft/m² */
    .project-specs-strip {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      padding-top: 12px;
      border-top: 1px solid #F1F5F9;
      margin-top: auto;
      font-size: 0.8rem;
      font-weight: 700;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    @media (max-width: 480px) {
      .project-specs-strip {
        gap: 8px;
        font-size: 0.76rem;
      }
    }
    .spec-item {
      display: flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }
    .spec-item i {
      color: #64748B;
      font-size: 0.88rem;
    }
    .roi-pill-altnest {
      margin-left: auto;
      background: #EFF6FF;
      color: #2563EB;
      border: 1px solid #DBEAFE;
      font-size: 0.74rem;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 6px;
      white-space: nowrap;
    }
  </style>

  <!-- Hero Section -->
  <section class="portfolio-hero">
    <div class="container">
      <h1>Nuestros Proyectos</h1>
      <p>Explora 27 desarrollos inmobiliarios seleccionados bajo rigurosos estándares de seguridad jurídica, fiduciaria y rentabilidad en República Dominicana.</p>
    </div>
  </section>

  <main>
    <div class="container">
      
      <!-- Filter Bar -->
      <div class="filter-bar-container">
        <div class="filter-grid">
          <div class="form-group">
            <label>Buscar Proyecto</label>
            <input type="text" id="filterSearch" class="form-control-input" placeholder="Nombre o código (ej. Marina, CIASA-001)..." oninput="applyFilters()">
          </div>

          <div class="form-group">
            <label>Región</label>
            <select id="filterRegion" class="form-control-select" onchange="applyFilters()">
              <option value="all">Todas las Regiones</option>
              <option value="Punta Cana">Punta Cana & Cap Cana</option>
              <option value="Bayahíbe">Bayahíbe & Dominicus</option>
              <option value="Juan Dolio">Juan Dolio & Guayacanes</option>
              <option value="Santo Domingo">Santo Domingo & DN</option>
              <option value="Baní">Baní / Peravia</option>
              <option value="Miches">Miches & Costa Esmeralda</option>
              <option value="Samaná">Las Terrenas / Samaná</option>
            </select>
          </div>

          <div class="form-group">
            <label>Tipo de Inmueble</label>
            <select id="filterType" class="form-control-select" onchange="applyFilters()">
              <option value="all">Todos los Tipos</option>
              <option value="Apartamentos">Apartamento</option>
              <option value="Villas">Villa / Casa</option>
              <option value="Townhouses">Townhouse</option>
              <option value="Terrenos">Terreno / Lote</option>
            </select>
          </div>

          <div class="form-group">
            <label>Presupuesto Máximo</label>
            <select id="filterPrice" class="form-control-select" onchange="applyFilters()">
              <option value="0">Sin Límite</option>
              <option value="150000">Hasta $150,000 USD</option>
              <option value="250000">Hasta $250,000 USD</option>
              <option value="400000">Hasta $400,000 USD</option>
              <option value="600000">Hasta $600,000 USD</option>
            </select>
          </div>

          <div class="confotur-toggle-wrap">
            <label class="confotur-toggle-label">
              <input type="checkbox" id="filterConfotur" onchange="applyFilters()">
              <span><i class="fa-solid fa-shield-check" style="color: var(--green);"></i> Solo CONFOTUR</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Contador de Resultados -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <span style="font-size: 0.95rem; font-weight: 700; color: var(--navy);" id="resultsCount">
          Mostrando <%= projects.length %> proyectos disponibles
        </span>
      </div>

      <!-- Grid de Proyectos Dinámico (Estilo Altnest Webflow) -->
      <div class="projects-grid" id="projectsGrid">
        <% projects.forEach(p => { %>
          <% 
            let rawImg = (p.image || '').trim();
            let cardImgUrl = rawImg.startsWith('http') 
              ? rawImg 
              : '/' + rawImg.replace(/^\/+/, '');
            let beds = p.bedrooms ? p.bedrooms : (p.rooms || '2');
            let baths = p.bathrooms ? p.bathrooms : (p.baths || '2');
            let size = p.sizeFrom ? (p.sizeFrom + ' M²') : '120 M²';
            let priceFmt = p.priceFrom ? ('$' + p.priceFrom.toLocaleString('en-US')) : '$180,000';
          %>
          <a href="/proyectos/<%= p.slug || p.id %>" class="project-card shine-effect interactive-card" 
             data-aos="fade-up"
             data-region="<%= p.region %>" 
             data-type="<%= p.type %>" 
             data-price="<%= p.priceFrom || 0 %>" 
             data-confotur="<%= p.confotur ? 'true' : 'false' %>"
             data-name="<%= (p.name + ' ' + (p.code || '') + ' ' + p.region + ' ' + (p.subLocation || '')).toLowerCase() %>">
            
            <div class="project-card-media" style="background-image: url('<%= cardImgUrl %>');">
              <span class="card-badge-region">
                <i class="fa-solid fa-location-dot"></i> <%= p.region %>
              </span>
              <% if (p.confotur) { %>
                <span class="card-badge-confotur">
                  <i class="fa-solid fa-shield-halved"></i> CONFOTUR
                </span>
              <% } %>
            </div>

            <div class="project-card-body">
              <!-- Top Row: Name and Price aligned horizontally -->
              <div class="project-header-row">
                <h2 class="project-card-title"><%= p.name %></h2>
                <div class="project-card-price"><%= priceFmt %></div>
              </div>

              <!-- Location line with subtle pin -->
              <div class="project-location-line">
                <i class="fa-solid fa-location-dot"></i>
                <span><%= p.subLocation ? p.subLocation + ', ' + p.region : p.region %>, República Dominicana</span>
              </div>

              <!-- Altnest Specs Strip -->
              <div class="project-specs-strip">
                <div class="spec-item">
                  <i class="fa-solid fa-bed"></i> <%= beds %> BEDS
                </div>
                <div class="spec-item">
                  <i class="fa-solid fa-bath"></i> <%= baths %> BATHS
                </div>
                <div class="spec-item">
                  <i class="fa-solid fa-vector-square"></i> <%= size %>
                </div>
                <% if (p.roi) { %>
                  <span class="roi-pill-altnest"><%= p.roi %></span>
                <% } %>
              </div>

            </div>
          </a>
        <% }); %>
      </div>

    </div>
  </main>

  <script>
    function applyFilters() {
      const search = document.getElementById('filterSearch').value.toLowerCase().trim();
      const region = document.getElementById('filterRegion').value;
      const type = document.getElementById('filterType').value;
      const maxPrice = parseFloat(document.getElementById('filterPrice').value) || 0;
      const onlyConfotur = document.getElementById('filterConfotur').checked;

      let visibleCount = 0;
      const cards = document.querySelectorAll('.project-card');

      cards.forEach(card => {
        const cardName = card.getAttribute('data-name');
        const cardRegion = card.getAttribute('data-region');
        const cardType = card.getAttribute('data-type');
        const cardPrice = parseFloat(card.getAttribute('data-price')) || 0;
        const cardConfotur = card.getAttribute('data-confotur') === 'true';

        let matchSearch = !search || cardName.includes(search);
        let matchRegion = region === 'all' || cardRegion.toLowerCase().includes(region.toLowerCase());
        let matchType = type === 'all' || cardType.toLowerCase().includes(type.toLowerCase());
        let matchPrice = maxPrice === 0 || cardPrice <= maxPrice;
        let matchConfotur = !onlyConfotur || cardConfotur;

        if (matchSearch && matchRegion && matchType && matchPrice && matchConfotur) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      document.getElementById('resultsCount').innerText = `Mostrando ${visibleCount} de ${cards.length} proyectos disponibles`;
    }
  </script>

<%- include('../layouts/footer') %>
