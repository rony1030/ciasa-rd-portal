      label: "Hablar Directamente con Paola Caram por WhatsApp",
      url: "https://wa.me/18092995233?text=Hola%20Paola,%20recib%C3%AD%20el%20correo%20de%20CIASA%20y%20deseo%20dar%20seguimiento%20a%20mi%20inversi%C3%B3n.",
      bgColor: "#7DB33A"
    },
    {
