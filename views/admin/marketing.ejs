        { id: "b1", type: "hero", src: "https://images.unsplash.com/photo-1540555700478-4be289fbecef?w=1000&auto=format&fit=crop&q=80" },
        { id: "b2", type: "heading", text: "Hola {{nombre}},", align: "left" },
        { id: "b3", type: "paragraph", html: "Gracias por contactar a <strong>CIASA Bolsa Inmobiliaria</strong>. Hemos recibido tu solicitud de asesoría patrimonial sobre proyectos en República Dominicana." },
        { id: "b4", type: "confotur", title: "Beneficios Exclusivos Ley CONFOTUR 158-01", items: ["15 Años de Exención del 100% del IPI.", "0% Impuesto de Transferencia Inmobiliaria.", "0% Impuesto sobre la Renta."] },
        { id: "b5", type: "button", label: "Hablar Directamente con Paola Caram por WhatsApp", url: "https://wa.me/18092995233", bgColor: "#7DB33A" },
        { id: "b6", type: "signature", name: "Paola Caram", role: "Directora Ejecutiva · CIASA Bolsa Inmobiliaria", contact: "paola.caram@ciasard.org.do · +1 (809) 299-5233" }
      ];
    } else if (preset === 'regiones') {
      document.getElementById('targetEmailSubject').value = "¿Punta Cana, Santo Domingo o Samaná? — Comparativa de Inversión CIASA";
      canvasBlocks = [
        { id: "b1", type: "heading", text: "Hola {{nombre}},", align: "left" },
        { id: "b2", type: "paragraph", html: "Al momento de invertir en bienes raíces en República Dominicana, la ubicación determina tu flujo de caja por rentas vacacionales." },
        { id: "b3", type: "cards" },
        { id: "b4", type: "button", label: "Ver Catálogo de 27 Proyectos", url: "https://ciasard.org.do/proyectos", bgColor: "#0A1E36" }
      ];
    } else if (preset === 'financiamiento') {
      document.getElementById('targetEmailSubject').value = "¿Cómo financiar tu propiedad en RD desde EE.UU. o Europa?";
      canvasBlocks = [
        { id: "b1", type: "heading", text: "Hola {{nombre}},", align: "left" },
        { id: "b2", type: "paragraph", html: "Comprar y financiar una propiedad en República Dominicana a distancia es 100% seguro con Fideicomiso Inmobiliario y Firma Digital." },
        { id: "b3", type: "confotur", title: "Pilares de Seguridad Jurídica", items: ["Precalificación hipotecaria en USD.", "Cuentas fiduciarias reguladas Banreservas/BHD/Popular."] },
        { id: "b4", type: "button", label: "Solicitar Asesoría Financiera", url: "https://wa.me/18092995233", bgColor: "#7DB33A" }
      ];
    } else {
      document.getElementById('targetEmailSubject').value = "Comunicado Oficial — CIASA Bolsa Inmobiliaria";
      canvasBlocks = [
        { id: "b1", type: "heading", text: "Hola {{nombre}},", align: "left" },
        { id: "b2", type: "paragraph", html: "Escribe aquí tu comunicado." }
      ];
    }
    deselectBlock();
    renderCanvas();
    switchSideTab('blocks');
  }

  function onCrmLeadChange(select) {
    const opt = select.options[select.selectedIndex];
    if (opt && opt.value) {
      document.getElementById('targetLeadName').value = opt.getAttribute('data-nombre') || '';
      document.getElementById('targetLeadEmail').value = opt.getAttribute('data-email') || '';
      renderCanvas();
    }
  }

  // ─── HERRAMIENTAS DE FORMATO WYSIWYG ────────────────────────────────────────
  function formatText(cmd) {
    document.execCommand(cmd, false, null);
  }

  function insertLink() {
    const url = prompt('Introduce la dirección URL del enlace:', 'https://ciasard.org.do');
    if (url) {
      document.execCommand('createLink', false, url);
    }
  }

  function insertMergeTag(tag) {
    document.execCommand('insertText', false, tag);
  }

  // ─── ACCIONES DE DESPACHO & PRUEBA ──────────────────────────────────────────
  async function submitCampaignSend() {
    const email = document.getElementById('targetLeadEmail').value.trim();
    const name = document.getElementById('targetLeadName').value.trim();
    const subject = document.getElementById('targetEmailSubject').value.trim();
    const leadSelect = document.getElementById('crmLeadSelect');
    const leadId = leadSelect ? leadSelect.value : '';

    if (!email || !email.includes('@')) {
      alert('Por favor especifica un correo electrónico válido en la pestaña Audiencia.');
      switchSideTab('audience');
      return;
    }

    try {
      const res = await fetch('/admin/marketing/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          templateId: 'bienvenida_dossier',
          leadId,
          customNombre: name,
          customEmail: email,
          customSubject: subject
        })
      });

      const data = await res.json();
      if (data.success) {
        alert('¡Campaña procesada y despachada exitosamente a ' + email + '!');
      } else {
        alert('Error al despachar: ' + (data.error || 'Desconocido'));
      }
    } catch (e) {
      alert('Error de conexión al enviar correo.');
    }
  }

  function sendDirectTestEmail() {
    const testEmail = prompt('Introduce el correo electrónico para enviar la prueba:', 'paola.caram@ciasard.org.do');
    if (testEmail && testEmail.includes('@')) {
      document.getElementById('targetLeadEmail').value = testEmail;
      submitCampaignSend();
    }
  }
</script>

