<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acceso al Panel Administrativo — CIASA Bolsa Inmobiliaria</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --primary: #7DB33A;
      --primary-hover: #68992E;
      --navy: #0A1E36;
      --navy-dark: #071526;
      --bg: #0A1E36;
      --card-bg: #FFFFFF;
      --border: #E2E8F0;
      --text-main: #0F172A;
      --text-muted: #64748B;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, rgba(7, 21, 38, 0.95), rgba(10, 30, 54, 0.92)), url('/assets/images/projects/marina-garden-2.jpg');
      background-size: cover;
      background-position: center;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      color: var(--text-main);
    }

    .login-card {
      background: #FFFFFF;
      border-radius: 18px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
      width: 100%;
      max-width: 420px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.15);
      animation: fadeIn 0.35s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .login-header {
      background: var(--navy);
      padding: 36px 32px 30px;
      text-align: center;
      color: #FFFFFF;
      position: relative;
    }

    .login-brand-icon {
      width: 58px;
      height: 58px;
      border-radius: 14px;
      background: rgba(125, 179, 58, 0.15);
      border: 1px solid rgba(125, 179, 58, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      color: var(--primary);
      font-size: 1.6rem;
    }

    .login-header h1 {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.3px;
      margin-bottom: 4px;
    }

    .login-header p {
      font-size: 0.84rem;
      color: #94A3B8;
      font-weight: 500;
    }

    .login-body {
      padding: 32px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .input-wrapper {
      position: relative;
    }

    .input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94A3B8;
      font-size: 1rem;
      transition: color 0.2s ease;
    }

    .form-input {
      width: 100%;
      height: 48px;
      padding: 0 14px 0 42px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font-size: 0.95rem;
      color: var(--text-main);
      background: #F8FAFC;
      transition: all 0.2s ease;
      outline: none;
      font-family: inherit;
    }

    .form-input:focus {
      border-color: var(--primary);
      background: #FFFFFF;
      box-shadow: 0 0 0 3px rgba(125, 179, 58, 0.15);
    }

    .form-input:focus + .input-icon,
    .form-input:focus ~ .input-icon {
      color: var(--primary);
    }

    .btn-submit {
      width: 100%;
      height: 48px;
      background: var(--primary);
      color: #FFFFFF;
      border: none;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(125, 179, 58, 0.35);
      margin-top: 26px;
    }

    .btn-submit:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(125, 179, 58, 0.45);
    }

    .btn-submit:active {
      transform: translateY(0);
    }

    .alert-error {
      background: #FEF2F2;
      border: 1px solid #F87171;
      color: #B91C1C;
      padding: 12px 14px;
      border-radius: 8px;
      font-size: 0.84rem;
      font-weight: 600;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .login-footer {
      text-align: center;
      padding: 0 32px 28px;
      font-size: 0.78rem;
      color: #94A3B8;
    }

    .login-footer a {
      color: #2563EB;
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="login-card">
    <div class="login-header">
      <div class="login-brand-icon">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h1>CIASA Admin</h1>
      <p>Suite Administrativa & CRM Inmobiliario</p>
    </div>

    <div class="login-body">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/admin/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="username">Usuario o Correo</label>
          <div class="input-wrapper">
            <input type="text" id="username" name="username" class="form-input" placeholder="" required autofocus autocomplete="username">
            <i class="fa-regular fa-user input-icon"></i>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Contraseña</label>
          <div class="input-wrapper">
            <input type="password" id="password" name="password" class="form-input" placeholder="" required autocomplete="current-password">
            <i class="fa-solid fa-lock input-icon"></i>
          </div>
        </div>

        <button type="submit" class="btn-submit">
          <span>Ingresar al Panel</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>
    </div>

    <div class="login-footer">
      <p><i class="fa-solid fa-lock" style="margin-right: 4px;"></i> Acceso Fiduciario & Comercial Protegido</p>
      <p style="margin-top: 6px;"><a href="/">← Regresar al Portal Público</a></p>
    </div>
  </div>

</body>
</html>
