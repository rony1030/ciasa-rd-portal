<%- include('layout', { pageTitle: 'Ajustes & SEO Manager', activePage: 'seo' }) %>

<div class="section-header">
  <div>
    <h2>Ajustes Generales & SEO Manager</h2>
    <p>Configuración del portal público, metaetiquetas de búsqueda, OpenGraph e integraciones</p>
  </div>
  <% if (typeof success !== 'undefined' && success) { %>
    <span class="badge badge-green"><i class="fa-solid fa-circle-check"></i> Configuración guardada exitosamente</span>
  <% } %>
</div>

<div>
  <form method="POST" action="/admin/seo">
    
    <!-- 1. SEO & Metadatos Globales -->
    <div class="form-card" style="margin-bottom: 24px;">
      <h3 style="font-size: 1rem; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 1px solid var(--border-color);">
        <i class="fa-solid fa-magnifying-glass-chart" style="color: var(--primary);"></i> Metadatos Globales de Google & Redes Sociales
      </h3>

      <div class="form-grid">
        <div class="form-group full">
          <label class="form-label">Título Global del Sitio (Meta Title) *</label>
          <input type="text" name="siteTitle" class="form-input" value="<%= ajustes.siteTitle %>" required>
        </div>

        <div class="form-group full">
          <label class="form-label">Descripción Global (Meta Description) *</label>
          <textarea name="siteDescription" class="form-input" rows="3" required><%= ajustes.siteDescription %></textarea>
        </div>

        <div class="form-group full">
          <label class="form-label">Palabras Clave (Meta Keywords)</label>
          <input type="text" name="metaKeywords" class="form-input" value="<%= ajustes.metaKeywords %>" placeholder="bienes raices rd, inversion inmobiliaria...">
        </div>

        <div class="form-group">
          <label class="form-label">Google Analytics / Tag Manager ID</label>
          <input type="text" name="googleAnalyticsId" class="form-input" value="<%= ajustes.googleAnalyticsId %>" placeholder="G-XXXXXXXXXX">
        </div>

        <!-- Imagen Social OpenGraph Visual (Sin URL visible) -->
        <div class="form-group">
          <label class="form-label">Imagen Social OpenGraph (OG:Image)</label>
          <div onclick="chooseOgImage()" style="position: relative; border: 1px solid #CBD5E1; border-radius: var(--radius-md); background: #F1F5F9; overflow: hidden; height: 95px; max-width: 220px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; box-shadow: var(--shadow-sm);" title="Cambiar imagen social">
            <img src="<%= ajustes.ogImage || '/assets/images/branding/ciasa-social-preview.jpg' %>" id="ogImagePreview" style="width: 100%; height: 100%; object-fit: cover; display: block;" onerror="this.src='/favicon.png';">
            <div style="position: absolute; inset: 0; background: rgba(15,23,42,0.5); display: flex; align-items: center; justify-content: center; gap: 6px; color: #FFFFFF; font-size: 0.76rem; font-weight: 700; opacity: 0; transition: opacity 0.15s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0'">
              <i class="fa-solid fa-camera"></i> Cambiar
            </div>
          </div>
          <input type="hidden" name="ogImage" id="ogImageInput" value="<%= ajustes.ogImage || '/assets/images/branding/ciasa-social-preview.jpg' %>">
        </div>
      </div>
    </div>

    <!-- 2. Inteligencia Artificial & Google Gemini API -->
    <div class="form-card" style="margin-bottom: 24px; border-left: 4px solid #2563EB;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 10px;">
        <h3 style="font-size: 1rem; margin: 0; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-wand-magic-sparkles" style="color: #2563EB;"></i> Inteligencia Artificial (Google Gemini API)
        </h3>
        <span class="badge badge-blue" style="font-size: 0.72rem;"><i class="fa-brands fa-google"></i> Gemini Pro / Flash</span>
      </div>

      <div class="form-grid">
        <div class="form-group full">
          <label class="form-label" style="display: flex; justify-content: space-between; align-items: center;">
            <span>API Key de Google Gemini *</span>
            <a href="https://aistudio.google.com/app/apikey" target="_blank" style="color: #2563EB; font-size: 0.72rem; text-decoration: none; font-weight: 700;">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> Obtener clave en Google AI Studio
            </a>
          </label>
          <div style="position: relative;">
            <input type="password" id="geminiApiKeyInput" name="geminiApiKey" class="form-input" value="<%= ajustes.geminiApiKey || '' %>" placeholder="AIzaSy..." style="padding-right: 42px; font-family: monospace;">
            <button type="button" onclick="toggleApiKeyVisibility()" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #64748B; cursor: pointer; font-size: 0.90rem;">
              <i class="fa-regular fa-eye" id="toggleEyeIcon"></i>
            </button>
          </div>
          <span style="font-size: 0.72rem; color: var(--text-muted); margin-top: 2px;">
            Esta clave se utiliza para el asistente inteligente del CRM, generador de correos de marketing y respuestas automáticas.
          </span>
        </div>

        <div class="form-group">
          <label class="form-label">Modelo de Gemini AI</label>
          <% 
            const currentModel = ajustes.geminiModel || 'gemini-2.5-flash';
            const standardModels = ['gemini-2.5-flash', 'gemini-2.5-pro', 'gemini-3.5-flash', 'gemini-3.5-pro', 'gemini-3.6-pro', 'gemini-2.0-flash'];
            const isCustom = !standardModels.includes(currentModel);
          %>
          <select id="geminiModelSelect" class="form-input" onchange="handleModelDropdownChange(this)">
            <option value="gemini-2.5-flash" <%= currentModel === 'gemini-2.5-flash' ? 'selected' : '' %>>Gemini 2.5 Flash (Recomendado — Ultra Rápido)</option>
            <option value="gemini-2.5-pro" <%= currentModel === 'gemini-2.5-pro' ? 'selected' : '' %>>Gemini 2.5 Pro</option>
            <option value="gemini-3.5-flash" <%= currentModel === 'gemini-3.5-flash' ? 'selected' : '' %>>Gemini 3.5 Flash</option>
            <option value="gemini-3.5-pro" <%= currentModel === 'gemini-3.5-pro' ? 'selected' : '' %>>Gemini 3.5 Pro</option>
            <option value="gemini-3.6-pro" <%= currentModel === 'gemini-3.6-pro' ? 'selected' : '' %>>Gemini 3.6 Pro</option>
            <option value="gemini-2.0-flash" <%= currentModel === 'gemini-2.0-flash' ? 'selected' : '' %>>Gemini 2.0 Flash</option>
            <option value="custom" <%= isCustom ? 'selected' : '' %>>Personalizado / Otro Modelo...</option>
          </select>
          <input type="text" name="geminiModel" id="geminiModelCustomInput" class="form-input" value="<%= currentModel %>" placeholder="Ej: gemini-3.5, gemini-3.6..." style="margin-top: 6px; display: <%= isCustom ? 'block' : 'none' %>;">
        </div>

        <div class="form-group">
          <label class="form-label">Estado de la Integración IA</label>
          <div style="display: flex; align-items: center; gap: 12px; height: 38px;">
            <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.84rem; cursor: pointer; font-weight: 700; color: var(--text-heading);">
              <input type="checkbox" name="geminiEnabled" value="true" <%= (typeof ajustes.geminiEnabled === 'undefined' || ajustes.geminiEnabled) ? 'checked' : '' %> style="accent-color: #2563EB; width: 16px; height: 16px;">
              <span>Habilitar funciones de IA en CRM</span>
            </label>
            <button type="button" id="btnTestGemini" class="btn btn-secondary btn-sm" onclick="testGeminiConnectionLive()" style="margin-left: auto;">
              <i class="fa-solid fa-plug-circle-check"></i> Probar Conexión
            </button>
          </div>
        </div>

        <!-- Alerta de Respuesta del Test de Gemini -->
        <div id="geminiTestResult" class="form-group full" style="display: none; margin-top: 6px;">
          <!-- Mensaje dinámico -->
        </div>
      </div>
    </div>

    <!-- 3. Canales de Contacto & Conversión -->
    <div class="form-card" style="margin-bottom: 24px;">
      <h3 style="font-size: 1rem; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 1px solid var(--border-color);">
        <i class="fa-solid fa-headset" style="color: var(--primary);"></i> Canales Oficiales de Contacto
      </h3>

      <div class="form-grid">
        <div class="form-group">
          <label class="form-label">Teléfono / WhatsApp Comercial Oficial</label>
          <input type="text" name="whatsappPhone" class="form-input" value="<%= ajustes.whatsappPhone %>" placeholder="+18097105591">
        </div>

        <div class="form-group">
          <label class="form-label">Email de Notificaciones de Nuevos Leads</label>
          <input type="email" name="contactoEmail" class="form-input" value="<%= ajustes.contactoEmail %>" placeholder="info@ciasard.com">
        </div>
      </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px;">
      <a href="/admin" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary" style="padding: 10px 28px; font-weight: 800;">
        <i class="fa-solid fa-cloud-arrow-up"></i> Guardar Ajustes Globales & IA
      </button>
    </div>

  </form>
</div>

<!-- MODAL SELECTOR RÁPIDO DE IMAGEN SOCIAL -->
<div id="ogGalleryModal" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.7); z-index: 10000; overflow-y: auto; backdrop-filter: blur(4px); padding: 40px 16px;">
  <div style="background: #FFFFFF; max-width: 650px; margin: 0 auto; border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-lg);">
    <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #FAFAFC;">
      <strong style="font-size: 0.95rem; color: var(--text-heading);"><i class="fa-regular fa-images"></i> Seleccionar Imagen Social OpenGraph</strong>
      <button type="button" onclick="closeOgGallery()" style="background: transparent; border: none; font-size: 1.2rem; cursor: pointer; color: var(--text-muted);">&times;</button>
    </div>
    
    <div style="padding: 20px;">
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-height: 360px; overflow-y: auto; padding-right: 6px;">
        <% 
          const ogImages = [
            '/assets/images/hero-dr.jpg',
            '/assets/images/flyers/pictures/Coastal_development_at_202604231822_2.jpeg',
            '/assets/images/flyers/pictures/Family_on_balcony_202604231822_3.jpeg',
            '/assets/images/projects/marina-garden-2.jpg',
            '/assets/images/projects/wave-garden.jpg',
            '/assets/images/projects/cap-cana-hero.jpg'
          ];
          ogImages.forEach(img => { 
        %>
          <div onclick="selectOgImage('<%= img %>')" style="cursor: pointer; border: 2px solid #E2E8F0; border-radius: 8px; overflow: hidden; height: 90px; transition: border-color 0.15s; background: #0F172A;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='#E2E8F0'">
            <img src="<%= img %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/favicon.png'">
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<script>
function chooseOgImage() {
  document.getElementById('ogGalleryModal').style.display = 'block';
}

function closeOgGallery() {
  document.getElementById('ogGalleryModal').style.display = 'none';
}

function selectOgImage(imgSrc) {
  document.getElementById('ogImageInput').value = imgSrc;
  document.getElementById('ogImagePreview').src = imgSrc;
  closeOgGallery();
}

function toggleApiKeyVisibility() {
  const input = document.getElementById('geminiApiKeyInput');
  const icon = document.getElementById('toggleEyeIcon');
  if (input.type === 'password') {
    input.type = 'text';
    icon.className = 'fa-regular fa-eye-slash';
  } else {
    input.type = 'password';
    icon.className = 'fa-regular fa-eye';
  }
}

function handleModelDropdownChange(selectEl) {
  const customInput = document.getElementById('geminiModelCustomInput');
  if (selectEl.value === 'custom') {
    customInput.style.display = 'block';
    customInput.focus();
  } else {
    customInput.style.display = 'none';
    customInput.value = selectEl.value;
  }
}

async function testGeminiConnectionLive() {
  const apiKey = document.getElementById('geminiApiKeyInput').value.trim();
  const selectVal = document.getElementById('geminiModelSelect').value;
  const customVal = document.getElementById('geminiModelCustomInput').value.trim();
  const model = selectVal === 'custom' ? (customVal || 'gemini-2.5-flash') : selectVal;
  const resultBox = document.getElementById('geminiTestResult');
  const btn = document.getElementById('btnTestGemini');

  if (!apiKey) {
    resultBox.style.display = 'block';
    resultBox.innerHTML = `
      <div style="padding: 10px 14px; background: #FEF2F2; border: 1px solid #FECACA; border-radius: 8px; color: #991B1B; font-size: 0.82rem; display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Ingresa primero una API Key de Gemini en el campo para probarla.</span>
      </div>
    `;
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Verificando con Google...';
  resultBox.style.display = 'block';
  resultBox.innerHTML = `
    <div style="padding: 10px 14px; background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 8px; color: #1D4ED8; font-size: 0.82rem; display: flex; align-items: center; gap: 8px;">
      <i class="fa-solid fa-spinner fa-spin"></i>
      <span>Enviando solicitud de prueba a Google Gemini (${model})...</span>
    </div>
  `;

  try {
    const res = await fetch('/admin/api/test-gemini', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ apiKey, model })
    });

    const data = await res.json();

    if (data.ok) {
      resultBox.innerHTML = `
        <div style="padding: 12px 16px; background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 8px; color: #15803D; font-size: 0.82rem; display: flex; flex-direction: column; gap: 4px;">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <strong style="display: flex; align-items: center; gap: 6px;"><i class="fa-solid fa-circle-check"></i> ${data.message}</strong>
            <span style="font-size: 0.72rem; background: #DCFCE7; padding: 2px 8px; border-radius: 4px; font-weight: 700;">${data.latencyMs} ms · ${data.model}</span>
          </div>
          <div style="font-size: 0.76rem; color: #166534; margin-top: 2px;">
            Respuesta IA: <em>"${data.reply}"</em>
          </div>
        </div>
      `;
    } else {
      resultBox.innerHTML = `
        <div style="padding: 12px 16px; background: #FEF2F2; border: 1px solid #FECACA; border-radius: 8px; color: #991B1B; font-size: 0.82rem; display: flex; flex-direction: column; gap: 4px;">
          <strong style="display: flex; align-items: center; gap: 6px;"><i class="fa-solid fa-circle-xmark"></i> Conexión Rechazada</strong>
          <span style="font-size: 0.76rem;">${data.error}</span>
        </div>
      `;
    }
  } catch (err) {
    resultBox.innerHTML = `
      <div style="padding: 12px 16px; background: #FEF2F2; border: 1px solid #FECACA; border-radius: 8px; color: #991B1B; font-size: 0.82rem;">
        <i class="fa-solid fa-triangle-exclamation"></i> Error al conectar con el servidor: ${err.message}
      </div>
    `;
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-plug-circle-check"></i> Probar Conexión';
  }
}
</script>

<%- include('layout-end') %>
