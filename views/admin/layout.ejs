<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin — CIASA Bolsa Inmobiliaria' %></title>
  <link rel="icon" href="/favicon.ico">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  
  <!-- ApexCharts para visualizaciones SaaS -->
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    
    :root {
      /* Paleta Primaria CIASA */
      --primary:         #7DB33A;
      --primary-hover:   #6EA032;
      --primary-active:  #5F8B2B;
      --primary-light:   #F4FBEA;
      --primary-subtle:  #E5F6D2;
      
      /* Azul Marino Corporativo */
      --secondary:       #0A1E36;
      --secondary-light: #122B4D;
      
      /* Acentos Funcionales SaaS */
      --accent-blue:     #2563EB;
      --accent-blue-bg:  #EFF6FF;
      --accent-purple:   #7C3AED;
      --accent-purple-bg:#F5F3FF;
      --accent-amber:    #D97706;
      --accent-amber-bg: #FFFBEB;
      --accent-emerald:  #059669;
      --accent-emerald-bg:#ECFDF5;
      --accent-rose:     #E11D48;
      --accent-rose-bg:  #FFF1F2;
      
      /* Fondos & Superficies Clean Dashboard */
      --body-bg:         #F4F6F9;
      --sidebar-bg:      #FFFFFF;
      --header-bg:       #FFFFFF;
      --card-bg:         #FFFFFF;
      
      /* Tipografía & Textos */
      --text-heading:    #111827;
      --text-body:       #374151;
      --text-muted:      #6B7280;
      --text-light:      #9CA3AF;
      
      /* Bordes & Sombras Suaves (WowDash Style) */
      --border-color:    #E5E7EB;
      --border-subtle:   #F3F4F6;
      --border-focus:    #7DB33A;
      
      --shadow-xs:       0 1px 2px 0 rgba(0, 0, 0, 0.03);
      --shadow-card:     0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.03);
      --shadow-hover:    0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.03);
      --shadow-dropdown: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
      --shadow-modal:    0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
      
      /* Radios */
      --radius-sm:       6px;
      --radius-md:       10px;
      --radius-lg:       14px;
      --radius-pill:     9999px;
    }

    body {
      font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--body-bg);
      color: var(--text-body);
      display: flex;
      min-height: 100vh;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      letter-spacing: -0.01em;
      font-size: 0.875rem;
      line-height: 1.5;
    }

    /* ==========================================================================
       SIDEBAR WOWDASH / FILLOW STYLE (LIMPIO & MINIMALISTA)
       ========================================================================== */
    .admin-sidebar {
      width: 240px;
      min-height: 100vh;
      background: var(--sidebar-bg);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0; left: 0; bottom: 0;
      z-index: 100;
      overflow-y: auto;
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .sidebar-logo {
      padding: 0 20px;
      height: 64px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid var(--border-subtle);
    }
    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none !important;
    }
    .sidebar-brand img { height: 32px; width: auto; flex-shrink: 0; }
    .sidebar-brand-title { font-size: 1.05rem; font-weight: 800; color: var(--secondary); letter-spacing: -0.3px; line-height: 1; }
    .sidebar-brand-tagline { font-size: 0.68rem; color: var(--primary); font-weight: 700; margin-top: 2px; }
    
    .sidebar-nav { padding: 14px 12px; flex: 1; display: flex; flex-direction: column; gap: 2px; }
    .sidebar-section-label { 
      font-size: 0.65rem; 
      font-weight: 700; 
      color: var(--text-light); 
      text-transform: uppercase; 
      letter-spacing: 0.08em; 
      padding: 14px 10px 4px; 
    }
    .sidebar-section-label:first-child { padding-top: 2px; }
    
    .sidebar-link { 
      display: flex; 
      align-items: center; 
      gap: 10px; 
      padding: 8px 10px; 
      border-radius: var(--radius-md); 
      text-decoration: none; 
      color: #4B5563; 
      font-size: 0.84rem; 
      font-weight: 600; 
      transition: all 0.15s ease; 
    }
    .sidebar-link i { 
      width: 18px; 
      text-align: center; 
      font-size: 0.90rem; 
      color: #9CA3AF; 
      transition: color 0.15s ease; 
    }
    .sidebar-link:hover { 
      background: var(--border-subtle); 
      color: var(--text-heading); 
    }
    .sidebar-link:hover i { 
      color: var(--secondary); 
    }
    .sidebar-link.active { 
      background: var(--primary-light); 
      color: #2D5810; 
      font-weight: 700; 
    }
    .sidebar-link.active i { 
      color: var(--primary); 
    }
    .sidebar-badge { 
      margin-left: auto; 
      background: var(--primary); 
      color: #FFFFFF; 
      font-size: 0.65rem; 
      font-weight: 800; 
      padding: 1px 6px; 
      border-radius: var(--radius-pill); 
    }
    .sidebar-badge.soon { 
      background: #F3F4F6; 
      color: var(--text-muted); 
      border: 1px solid var(--border-color); 
    }

    /* ==========================================================================
       MAIN CONTAINER & TOPBAR (LIVIANO & 100% FLUIDO)
       ========================================================================== */
    .admin-main {
      margin-left: 240px;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: var(--body-bg);
      min-width: 0;
    }
    .admin-topbar {
      background: var(--header-bg);
      border-bottom: 1px solid var(--border-color);
      padding: 0 24px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .topbar-left { display: flex; align-items: center; gap: 12px; }
    .topbar-search-box {
      position: relative;
      width: 280px;
    }
    .topbar-search-input {
      width: 100%;
      height: 38px;
      background: #F9FAFB;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0 14px 0 36px;
      font-size: 0.84rem;
      font-family: inherit;
      font-weight: 500;
      color: var(--text-heading);
      outline: none;
      transition: all 0.15s ease;
    }
    .topbar-search-input:focus {
      border-color: var(--primary);
      background: #FFFFFF;
      box-shadow: 0 0 0 3px rgba(125, 179, 58, 0.12);
      width: 320px;
    }
    .topbar-search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-light);
      font-size: 0.82rem;
      pointer-events: none;
    }

    /* BOTONES DE LA TOPBAR */
    .sidebar-toggle-btn {
      display: none !important;
    }
    @media (max-width: 1024px) {
      .sidebar-toggle-btn {
        display: inline-flex !important;
      }
    }
    .topbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .icon-btn {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-color);
      background: #FFFFFF;
      color: #4B5563;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 0.90rem;
      position: relative;
      transition: all 0.15s ease;
    }
    .icon-btn:hover {
      background: var(--border-subtle);
      color: var(--text-heading);
      border-color: #D1D5DB;
    }
    .icon-badge-dot {
      position: absolute;
      top: -2px;
      right: -2px;
      background: #EF4444;
      color: #FFFFFF;
      font-size: 0.60rem;
      font-weight: 800;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #FFFFFF;
    }

    /* USER AVATAR PILL PAOLA CARAM */
    .user-pill {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 3px 10px 3px 3px;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      background: #FFFFFF;
      cursor: pointer;
      transition: all 0.15s ease;
      position: relative;
    }
    .user-pill:hover {
      border-color: #D1D5DB;
      background: #F9FAFB;
    }
    .user-avatar-img {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      object-fit: cover;
      background: var(--secondary-light);
    }
    .user-name {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-heading);
      line-height: 1.1;
    }
    .user-role-label {
      font-size: 0.68rem;
      color: var(--text-muted);
      font-weight: 600;
      display: block;
      margin-top: 1px;
    }

    /* DROPDOWNS */
    .dropdown-menu-hando {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      width: 290px;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-dropdown);
      padding: 8px;
      display: none;
      z-index: 1000;
      animation: dropFade 0.15s ease;
    }
    .dropdown-menu-hando.show { display: block; }
    @keyframes dropFade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

    .dropdown-header-h {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 8px 8px;
      border-bottom: 1px solid var(--border-subtle);
      margin-bottom: 6px;
    }
    .dropdown-header-h strong { font-size: 0.84rem; color: var(--text-heading); }
    .dropdown-item-h {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 8px 10px;
      border-radius: var(--radius-sm);
      text-decoration: none;
      color: var(--text-body);
      font-size: 0.82rem;
      font-weight: 600;
      transition: all 0.15s;
    }
    .dropdown-item-h:hover {
      background: var(--border-subtle);
      color: var(--secondary);
    }
    .dropdown-item-h i { width: 16px; text-align: center; color: var(--text-muted); }
    .dropdown-item-h:hover i { color: var(--primary); }

    .admin-content {
      padding: 20px 24px;
      flex: 1;
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }

    /* ==========================================================================
       CARDS & STATS (WOWDASH MINIMALISTA)
       ========================================================================== */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 20px;
    }
    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px 18px;
      box-shadow: var(--shadow-card);
      transition: all 0.15s ease;
      display: flex;
      flex-direction: column;
    }
    .stat-card:hover {
      box-shadow: var(--shadow-hover);
      border-color: #D1D5DB;
    }
    .stat-card-label { font-size: 0.74rem; font-weight: 600; color: var(--text-muted); }
    .stat-card-value { font-size: 1.65rem; font-weight: 800; color: var(--text-heading); line-height: 1.1; margin: 4px 0; letter-spacing: -0.02em; }
    .stat-card-sub { font-size: 0.74rem; color: var(--text-muted); }

    /* CHARTS CONTAINER */
    .chart-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 16px;
      margin-bottom: 20px;
    }
    .chart-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 18px 20px;
      box-shadow: var(--shadow-card);
    }
    .chart-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .chart-card-header h3 {
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--text-heading);
    }

    /* TABLAS MODERNAS & SOBRIAS */
    .admin-table-wrap {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      box-shadow: var(--shadow-card);
      width: 100%;
    }
    .admin-table { 
      width: 100%; 
      border-collapse: collapse; 
      font-size: 0.84rem; 
      text-align: left;
    }
    .admin-table thead th { 
      background: #F9FAFB; 
      padding: 10px 14px; 
      font-size: 0.70rem; 
      font-weight: 700; 
      color: var(--text-muted); 
      text-transform: uppercase; 
      letter-spacing: 0.05em; 
      border-bottom: 1px solid var(--border-color); 
      white-space: nowrap; 
    }
    .admin-table tbody td { 
      padding: 12px 14px; 
      border-bottom: 1px solid var(--border-subtle); 
      vertical-align: middle; 
      color: var(--text-body); 
    }
    .admin-table tbody tr:last-child td { border-bottom: none; }
    .admin-table tbody tr:hover td { background: #F9FAFB; }

    /* BADGES */
    .badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: var(--radius-pill); font-size: 0.70rem; font-weight: 700; white-space: nowrap; }
    .badge-green  { background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; }
    .badge-blue   { background: #EFF6FF; color: #2563EB; border: 1px solid #BFDBFE; }
    .badge-orange { background: #FFFBEB; color: #D97706; border: 1px solid #FDE68A; }
    .badge-red    { background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; }
    .badge-gray   { background: #F3F4F6; color: #4B5563; border: 1px solid #E5E7EB; }
    .badge-purple { background: #F5F3FF; color: #7C3AED; border: 1px solid #DDD6FE; }

    /* BOTONES */
    .btn { 
      display: inline-flex; 
      align-items: center; 
      justify-content: center; 
      gap: 6px; 
      padding: 8px 16px; 
      border-radius: var(--radius-sm); 
      font-size: 0.82rem; 
      font-weight: 600; 
      cursor: pointer; 
      border: 1px solid transparent; 
      text-decoration: none !important; 
      transition: all 0.15s ease; 
      font-family: inherit; 
      white-space: nowrap;
    }
    .btn-primary { 
      background: var(--primary); 
      color: #FFFFFF !important; 
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05); 
    }
    .btn-primary:hover { 
      background: var(--primary-hover); 
    }
    .btn-primary:active {
      background: var(--primary-active);
    }
    .btn-secondary { 
      background: #FFFFFF; 
      border-color: var(--border-color); 
      color: var(--text-heading) !important; 
      box-shadow: var(--shadow-xs); 
    }
    .btn-secondary:hover { 
      background: var(--border-subtle); 
      border-color: #D1D5DB; 
    }
    .btn-danger { background: #FEF2F2; border-color: #FECACA; color: #DC2626 !important; }
    .btn-danger:hover { background: #DC2626; color: #FFFFFF !important; }
    .btn-sm { padding: 5px 10px; font-size: 0.76rem; }

    /* SECCIÓN ENCABEZADOS */
    .section-header { 
      display: flex; 
      align-items: center; 
      justify-content: space-between; 
      margin-bottom: 20px; 
      flex-wrap: wrap; 
      gap: 12px; 
    }
    .section-header h2 { font-size: 1.25rem; font-weight: 800; color: var(--text-heading); letter-spacing: -0.02em; }
    .section-header p { font-size: 0.80rem; color: var(--text-muted); margin-top: 1px; }

    /* FORMULARIOS & DROPDOWNS */
    .form-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 20px;
      box-shadow: var(--shadow-card);
    }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-grid.three { grid-template-columns: 1fr 1fr 1fr; }
    .form-group { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .form-group.full { grid-column: 1 / -1; }
    .form-label { font-size: 0.74rem; font-weight: 600; color: var(--text-heading); }
    .form-input { 
      background: #FFFFFF; 
      border: 1px solid var(--border-color); 
      border-radius: var(--radius-sm); 
      padding: 8px 12px; 
      color: var(--text-heading); 
      font-size: 0.84rem; 
      font-family: inherit; 
      font-weight: 500; 
      transition: all 0.15s ease; 
      width: 100%; 
      box-shadow: var(--shadow-xs); 
    }
    .form-input:focus { 
      outline: none; 
      border-color: var(--primary); 
      box-shadow: 0 0 0 3px rgba(125, 179, 58, 0.12); 
    }
    textarea.form-input { resize: vertical; min-height: 80px; line-height: 1.5; }

    /* CUSTOM DROPDOWNS MINIMALISTAS */
    .custom-dropdown-wrap {
      position: relative;
      width: 100%;
    }
    .custom-dropdown-trigger {
      width: 100%;
      min-height: 38px;
      padding: 6px 12px;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      background: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--text-heading);
      transition: all 0.15s ease;
      box-shadow: var(--shadow-xs);
      user-select: none;
    }
    .custom-dropdown-trigger:hover {
      border-color: #D1D5DB;
      background: #F9FAFB;
    }
    .custom-dropdown-wrap.active .custom-dropdown-trigger {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(125, 179, 58, 0.12);
    }
    .custom-dropdown-trigger i.chevron-icon {
      font-size: 0.72rem;
      color: var(--text-light);
      transition: transform 0.18s ease;
    }
    .custom-dropdown-wrap.active .custom-dropdown-trigger i.chevron-icon {
      transform: rotate(180deg);
      color: var(--primary);
    }
    .custom-dropdown-menu {
      display: none;
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-dropdown);
      padding: 4px;
      z-index: 1050;
      max-height: 240px;
      overflow-y: auto;
      animation: dropFade 0.12s ease;
    }
    .custom-dropdown-wrap.active .custom-dropdown-menu { display: block; }
    .custom-dropdown-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 7px 10px;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 600;
      color: #374151;
      cursor: pointer;
      transition: all 0.12s ease;
    }
    .custom-dropdown-item:hover {
      background: #F3F4F6;
      color: var(--secondary);
    }
    .custom-dropdown-item.selected {
      background: var(--primary-light);
      color: #2D5810;
      font-weight: 700;
    }

    /* KANBAN BOARD TRACKFLOW / WOWDASH */
    .kanban-container {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 12px;
    }
    .kanban-board {
      display: grid;
      grid-template-columns: repeat(5, minmax(260px, 1fr));
      gap: 14px;
      align-items: flex-start;
      min-width: 1100px;
    }
    .kanban-column {
      background: #F3F4F6;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 12px 10px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 440px;
    }
    .kanban-column-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 4px 4px;
    }
    .kanban-column-title {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-heading);
    }
    .kanban-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }
    .kanban-dot.nuevo { background: #EF4444; }
    .kanban-dot.contactado { background: #8B5CF6; }
    .kanban-dot.calificado { background: #3B82F6; }
    .kanban-dot.negociacion { background: #10B981; }
    .kanban-dot.cerrado { background: #F59E0B; }
    .kanban-count {
      font-size: 0.70rem;
      font-weight: 700;
      background: #E5E7EB;
      color: #4B5563;
      padding: 1px 6px;
      border-radius: 50px;
    }
    .kanban-cards-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 360px;
    }
    .kanban-card {
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 12px;
      box-shadow: var(--shadow-xs);
      cursor: grab;
      transition: all 0.15s ease;
    }
    .kanban-card:hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow-hover);
      border-color: #D1D5DB;
    }

    /* FILTROS GENERALES */
    .filter-bar { 
      background: var(--card-bg); 
      border: 1px solid var(--border-color); 
      border-radius: var(--radius-md); 
      padding: 14px 16px; 
      margin-bottom: 18px; 
      display: flex; 
      gap: 12px; 
      flex-wrap: wrap; 
      align-items: flex-end; 
      box-shadow: var(--shadow-card); 
    }
    .filter-bar .form-group { min-width: 140px; flex: 1; }

    /* TOGGLE SWITCH */
    .toggle { position: relative; display: inline-block; width: 36px; height: 20px; }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .toggle-slider { position: absolute; inset: 0; background: #D1D5DB; border-radius: 20px; cursor: pointer; transition: 0.2s ease; }
    .toggle-slider::before { content: ''; position: absolute; height: 14px; width: 14px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.2s ease; }
    .toggle input:checked + .toggle-slider { background: var(--primary); }
    .toggle input:checked + .toggle-slider::before { transform: translateX(16px); }

    /* MODALES FLOTANTES CENTRADOS */
    .modal-backdrop {
      position: fixed !important;
      inset: 0 !important;
      background: rgba(17, 24, 39, 0.6) !important;
      backdrop-filter: blur(4px) !important;
      -webkit-backdrop-filter: blur(4px) !important;
      z-index: 9999 !important;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      animation: modalFadeIn 0.15s ease-out;
    }
    @keyframes modalFadeIn { from { opacity: 0; } to { opacity: 1; } }
    .modal-dialog {
      background: #FFFFFF;
      border-radius: var(--radius-lg);
      max-width: 760px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--shadow-modal);
      display: flex;
      flex-direction: column;
    }
    .modal-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .modal-close {
      background: transparent;
      border: none;
      font-size: 1.3rem;
      color: var(--text-light);
      cursor: pointer;
      line-height: 1;
      padding: 2px 6px;
      border-radius: 4px;
    }
    .modal-close:hover { color: var(--text-heading); background: #F3F4F6; }
    .modal-body { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
    .modal-footer {
      padding: 12px 20px;
      border-top: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
    }

    /* RESPONSIVE FLUIDO MULTI-RESOLUCIÓN */
    @media (max-width: 1024px) {
      .admin-sidebar { transform: translateX(-100%); }
      .admin-sidebar.open { transform: translateX(0); }
      .admin-main { margin-left: 0; width: 100%; }
      .chart-grid { grid-template-columns: 1fr; }
      .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(17, 24, 39, 0.4); backdrop-filter: blur(2px); z-index: 99; }
      .sidebar-overlay.open { display: block; }
      .admin-content { padding: 16px 14px; }
      .form-grid, .form-grid.three { grid-template-columns: 1fr; }
    }

    @media (max-width: 768px) {
      .admin-topbar { padding: 0 14px; height: 58px; }
      .topbar-search-box { display: none; }
      .user-name { display: none; }
      .user-pill { padding: 2px; }
      .user-pill i { display: none; }
      .section-header { flex-direction: column; align-items: flex-start; gap: 8px; margin-bottom: 14px; }
      .filter-bar { padding: 12px; gap: 8px; }
      .filter-bar .form-group { min-width: 100%; flex: 1 1 100%; }
      .stat-grid { grid-template-columns: 1fr; gap: 10px; }
      .admin-content { padding: 12px 10px; }
    }
  </style>
</head>
