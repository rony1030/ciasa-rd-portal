<!-- SCRIPTS NATIVOS DE CARGA & CONSULTA -->
<script src="/js/curated_npi_data.js"></script>
<script>
  const API_BASE = '/api/npi';
  let currentPage = 1;
  const pageLimit = 100;
  let totalPages = 1;
  let totalMatching = 0;
  let selectedNpis = new Set();
  let currentRows = [];
  let currentSocialTab = 'meta';

  document.addEventListener('DOMContentLoaded', async () => {
    await loadStatesAndGlobalMetrics();
    document.getElementById('stateSelect').value = 'FL';
    fetchLeads();
    switchSocialTab('meta');
  });

  async function loadStatesAndGlobalMetrics() {
    try {
      const res = await fetch(`${API_BASE}/states`);
      if (!res.ok) throw new Error('API offline');
      const data = await res.json();
      document.getElementById('kpiTotalProviders').textContent = Number(data.total_providers || 8880716).toLocaleString();
      document.getElementById('kpiTotalLatinos').textContent = Number(data.total_latinos || 1420500).toLocaleString();
      document.getElementById('kpiTotalEmails').textContent = Number(data.total_emails || 2150000).toLocaleString();
      document.getElementById('kpiTotalPhones').textContent = Number(data.total_phones || 3890000).toLocaleString();
    } catch (err) {
      document.getElementById('kpiTotalProviders').textContent = '8,880,716';
      document.getElementById('kpiTotalLatinos').textContent = '1,420,500';
      document.getElementById('kpiTotalEmails').textContent = '2,150,000';
      document.getElementById('kpiTotalPhones').textContent = '3,890,000';
    }
  }

  function toggleLatinoFilter() {
    const chk = document.getElementById('checkLatino');
    chk.checked = !chk.checked;
    onFilterChange();
  }

  function onPresetDropdownChange(selectEl) {
    applyPreset(selectEl.value);
  }

  function applyPreset(presetType) {
    const stateSelect = document.getElementById('stateSelect');
    const specSelect = document.getElementById('specialtySelect');
    const quintSelect = document.getElementById('quintileSelect');
    const checkLatino = document.getElementById('checkLatino');
    const checkPhone = document.getElementById('checkPhone');
    const checkEmail = document.getElementById('checkEmail');

    checkPhone.checked = false;
    checkEmail.checked = false;
    specSelect.value = 'ALL';
    quintSelect.value = 'ALL';

    if (presetType === 'FL_LATINO') { stateSelect.value = 'FL'; checkLatino.checked = true; }
    else if (presetType === 'NY_LATINO') { stateSelect.value = 'NY'; checkLatino.checked = true; }
    else if (presetType === 'CA_LATINO') { stateSelect.value = 'CA'; checkLatino.checked = true; }
    else if (presetType === 'TX_LATINO') { stateSelect.value = 'TX'; checkLatino.checked = true; }
    else if (presetType === 'Q5_ALL') { stateSelect.value = 'ALL'; quintSelect.value = '5'; checkLatino.checked = false; }
    else if (presetType === 'DENTISTAS') { stateSelect.value = 'ALL'; specSelect.value = 'Odontología / Dentista'; checkLatino.checked = false; }
    else { stateSelect.value = 'ALL'; checkLatino.checked = false; }

    onFilterChange();
  }

  function resetFilters() {
    document.getElementById('stateSelect').value = 'FL';
    document.getElementById('specialtySelect').value = 'ALL';
    document.getElementById('quintileSelect').value = 'ALL';
    document.getElementById('checkLatino').checked = true;
    document.getElementById('checkPhone').checked = false;
    document.getElementById('checkEmail').checked = false;
    document.getElementById('checkSocial').checked = false;
    document.getElementById('searchInput').value = '';
    selectedNpis.clear();
    onFilterChange();
  }

  function onFilterChange() {
    currentPage = 1;
    fetchLeads();
  }

  let searchTimer = null;
  function onSearchInput() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      currentPage = 1;
      fetchLeads();
    }, 350);
  }

  async function fetchLeads() {
    const state = document.getElementById('stateSelect').value;
    const specialty = document.getElementById('specialtySelect').value;
    const quintile = document.getElementById('quintileSelect').value;
    const latinoOnly = document.getElementById('checkLatino').checked ? '1' : '0';
    const hasPhone = document.getElementById('checkPhone').checked ? '1' : '0';
    const hasEmail = document.getElementById('checkEmail').checked ? '1' : '0';
    const hasSocial = document.getElementById('checkSocial').checked ? '1' : '0';
    const q = document.getElementById('searchInput').value.trim();

    const tbody = document.getElementById('tableBody');
    const cardsGrid = document.getElementById('mobileCardsGrid');
    const dataCounts = document.getElementById('dataCounts');

    dataCounts.innerHTML = '<span style="color:#2563EB;"><i class="fa-solid fa-spinner fa-spin"></i> Consultando...</span>';

    const params = new URLSearchParams({
      state, specialty, quintile, latino_only: latinoOnly, has_phone: hasPhone, has_email: hasEmail, has_social: hasSocial, q, page: currentPage, limit: pageLimit
    });

    try {
      const res = await fetch(`${API_BASE}/search?${params.toString()}`);
      if (!res.ok) throw new Error('API offline');
      const data = await res.json();
      currentRows = data.providers || [];
      totalMatching = data.total_matching || 0;
      totalPages = data.total_pages || 1;
      renderData(currentRows);
      updatePagination();
    } catch (err) {
      // Fallback local dataset en memoria
      const all = window.CURATED_NPI_LEADS || [];
      const filtered = all.filter(p => {
        if (state && state !== 'ALL' && p.state !== state) return false;
        if (specialty && specialty !== 'ALL' && !p.specialty.toLowerCase().includes(specialty.toLowerCase())) return false;
        if (quintile && quintile !== 'ALL' && String(p.income_quintile) !== String(quintile)) return false;
        if (latinoOnly === '1' && !p.is_latino) return false;
        if (hasPhone === '1' && !p.phone) return false;
        if (hasEmail === '1' && !p.email) return false;
        if (hasSocial === '1' && !(p.linkedin_url || p.facebook_url || p.instagram_url)) return false;
        if (q) {
          const query = q.toLowerCase();
          if (!(p.name || '').toLowerCase().includes(query) && !(p.city || '').toLowerCase().includes(query)) return false;
        }
        return true;
      });
      currentRows = filtered.slice((currentPage - 1) * pageLimit, currentPage * pageLimit);
      totalMatching = filtered.length;
      totalPages = Math.ceil(filtered.length / pageLimit) || 1;
      renderData(currentRows);
      updatePagination();
    }
  }

  function renderData(rows) {
    const tbody = document.getElementById('tableBody');
    const cardsGrid = document.getElementById('mobileCardsGrid');
    const dataCounts = document.getElementById('dataCounts');

    if (!rows || rows.length === 0) {
      tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; padding:40px; color:#94A3B8;">No se encontraron prospectos con los filtros seleccionados</td></tr>';
      cardsGrid.innerHTML = '<div style="text-align:center; padding:40px; color:#94A3B8;">No se encontraron prospectos</div>';
      dataCounts.textContent = '0 prospectos';
      return;
    }

    const startIdx = (currentPage - 1) * pageLimit + 1;
    const endIdx = Math.min(startIdx + rows.length - 1, totalMatching);
    dataCounts.innerHTML = `<span><strong>${startIdx.toLocaleString()}-${endIdx.toLocaleString()}</strong> de <strong>${totalMatching.toLocaleString()}</strong></span>`;

    let tableHtml = '';
    rows.forEach(p => {
      const isChecked = selectedNpis.has(p.npi) ? 'checked' : '';
      const latinoBadge = p.is_latino ? '<span class="badge-latino">Latino</span>' : '';
      const phoneClean = (p.phone || '').replace(/[^0-9]/g, '');
      const waUrl = phoneClean ? `https://wa.me/1${phoneClean}?text=${encodeURIComponent('Hola Dr(a). ' + (p.name || '') + ', le saludamos de Bolsa Inmobiliaria RD.')}` : '#';
      const linkedinUrl = p.linkedin_url ? p.linkedin_url : `https://www.linkedin.com/search/results/all/?keywords=${encodeURIComponent('Dr. ' + (p.name || '') + ' ' + (p.city || '') + ' ' + (p.state || ''))}`;
      const googleSearchUrl = `https://www.google.com/search?q=${encodeURIComponent('Dr. ' + (p.name || '') + ' ' + (p.specialty || '') + ' ' + (p.city || '') + ' ' + (p.state || ''))}`;

      tableHtml += `
        <tr>
          <td style="text-align: center;"><input type="checkbox" ${isChecked} onchange="toggleSelectLead('${p.npi}', this.checked)"></td>
          <td style="font-family: monospace; font-weight: 700; color: #475569;">${p.npi}</td>
          <td style="font-weight: 700; color: #0F172A;">${p.name || 'N/A'} ${latinoBadge}</td>
          <td style="color: #475569; font-size: 0.82rem;">${p.specialty || 'General'}</td>
          <td><span style="background: #F1F5F9; padding: 2px 6px; border-radius: 4px; font-size: 0.72rem; font-weight: 700;">${p.credentials || 'MD'}</span></td>
          <td>${p.city || ''}, ${p.state || ''}</td>
          <td>${p.phone ? `<a href="tel:${p.phone}" style="color:#0F172A; text-decoration:none; font-weight:600;">${p.phone}</a>` : '—'}</td>
          <td>${p.email ? `<a href="mailto:${p.email}" style="color:#2563EB; text-decoration:none; font-weight:600;">${p.email}</a>` : '—'}</td>
          <td><span class="badge-quintile q${p.income_quintile || 3}">Q${p.income_quintile || 3}</span></td>
          <td>
            <div style="display:flex; align-items:center; gap:8px;">
              ${p.phone ? `<a href="${waUrl}" target="_blank" style="color: #16A34A; font-size: 1rem;" title="Abrir WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>` : ''}
              ${p.email ? `<a href="mailto:${p.email}" style="color: #2563EB; font-size: 0.95rem;" title="Enviar Email"><i class="fa-regular fa-envelope"></i></a>` : ''}
              <a href="${linkedinUrl}" target="_blank" style="color: #0A66C2; font-size: 0.95rem;" title="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
              <a href="${googleSearchUrl}" target="_blank" style="color: #EA4335; font-size: 0.95rem;" title="Buscar en Google"><i class="fa-brands fa-google"></i></a>
            </div>
          </td>
        </tr>
      `;
    });
    tbody.innerHTML = tableHtml;

    let cardsHtml = '';
    rows.forEach(p => {
      const latinoBadge = p.is_latino ? '<span class="badge-latino">Latino</span>' : '';
      const phoneClean = (p.phone || '').replace(/[^0-9]/g, '');
      const waUrl = phoneClean ? `https://wa.me/1${phoneClean}?text=${encodeURIComponent('Hola Dr(a). ' + (p.name || '') + ', le saludamos de Bolsa Inmobiliaria RD.')}` : '#';
      const linkedinUrl = p.linkedin_url ? p.linkedin_url : `https://www.linkedin.com/search/results/all/?keywords=${encodeURIComponent('Dr. ' + (p.name || '') + ' ' + (p.city || '') + ' ' + (p.state || ''))}`;

      cardsHtml += `
        <div class="npi-lead-card">
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <strong style="color: #0F172A; font-size: 0.92rem;">${p.name || 'N/A'} ${latinoBadge}</strong>
              <div style="font-size: 0.78rem; color: #64748B;">${p.specialty || 'Medicina General'} · ${p.credentials || 'MD'}</div>
            </div>
            <span class="badge-quintile q${p.income_quintile || 3}">Q${p.income_quintile || 3}</span>
          </div>
          <div style="font-size: 0.76rem; color: #64748B;"><i class="fa-solid fa-location-dot"></i> ${p.city || ''}, ${p.state || ''}</div>
          <div style="display: flex; gap: 8px; margin-top: 6px; border-top: 1px solid #F1F5F9; padding-top: 8px;">
            ${p.phone ? `<a href="tel:${p.phone}" class="btn btn-secondary btn-sm" style="flex:1; justify-content:center;"><i class="fa-solid fa-phone"></i> Llamar</a>` : ''}
            ${p.phone ? `<a href="${waUrl}" target="_blank" class="btn btn-sm" style="background:#25D366; color:#FFFFFF; flex:1; justify-content:center;"><i class="fa-brands fa-whatsapp"></i> Chat</a>` : ''}
            <a href="${linkedinUrl}" target="_blank" class="btn btn-secondary btn-sm" style="color:#0A66C2;"><i class="fa-brands fa-linkedin"></i></a>
          </div>
        </div>
      `;
    });
    cardsGrid.innerHTML = cardsHtml;
  }

  function switchView(view) {
    const table = document.getElementById('tableContainer');
    const cards = document.getElementById('mobileCardsGrid');
    const btnT = document.getElementById('btnViewTable');
    const btnC = document.getElementById('btnViewCards');

    if (view === 'cards') {
      table.style.display = 'none';
      cards.style.display = 'grid';
      btnT.classList.remove('active');
      btnC.classList.add('active');
    } else {
      table.style.display = 'block';
      cards.style.display = 'none';
      btnC.classList.remove('active');
      btnT.classList.add('active');
    }
  }

  function toggleSelectLead(npi, isSelected) {
    if (isSelected) selectedNpis.add(npi);
    else selectedNpis.delete(npi);
  }

  function toggleSelectAll(masterCheckbox) {
    const checkboxes = document.querySelectorAll('#tableBody input[type="checkbox"]');
    checkboxes.forEach(cb => {
      cb.checked = masterCheckbox.checked;
      const npi = cb.getAttribute('onchange').match(/'(\d+)'/)?.[1];
      if (npi) {
        if (masterCheckbox.checked) selectedNpis.add(npi);
        else selectedNpis.delete(npi);
      }
    });
  }

  function updatePagination() {
    document.getElementById('paginationInfo').textContent = `Página ${currentPage} de ${totalPages}`;
    document.getElementById('btnPrevPage').disabled = (currentPage <= 1);
    document.getElementById('btnNextPage').disabled = (currentPage >= totalPages);
  }
  function changePage(delta) {
    currentPage += delta;
    fetchLeads();
  }

  /* Modales */
  function openSocialAdsModal() { document.getElementById('socialAdsModal').style.display = 'flex'; }
  function closeSocialAdsModal() { document.getElementById('socialAdsModal').style.display = 'none'; }
  
  const SOCIAL_INFO = {
    meta: { title: 'Meta Custom Audiences (Facebook & Instagram)', desc: 'Genera un archivo CSV listo para subir en Meta Ads Manager -> Públicos Personalizados -> Lista de Clientes.' },
    google: { title: 'Google Ads (Customer Match)', desc: 'Genera un archivo CSV compatible con Google Ads (Search, Display y YouTube Ads).' },
    linkedin: { title: 'LinkedIn Matched Audiences', desc: 'Exporta la lista para campañas B2B hiper-segmentadas a médicos en LinkedIn Campaign Manager.' },
    whatsapp: { title: 'WhatsApp Business & Mensajería Directa', desc: 'Genera listado con números internacionales (+1) para prospección comercial 1 a 1.' }
  };

  function switchSocialTab(platform, btnElement) {
    currentSocialTab = platform;
    document.querySelectorAll('.social-tab-btn').forEach(b => b.classList.remove('active'));
    if (btnElement) btnElement.classList.add('active');
    const info = SOCIAL_INFO[platform];
    document.getElementById('socialPlatformInfo').innerHTML = `<strong>${info.title}</strong><p style="margin-top:4px; font-size:0.80rem; color:#64748B;">${info.desc}</p>`;
  }

  function downloadSocialAudience() {
    const data = (selectedNpis.size > 0) ? currentRows.filter(p => selectedNpis.has(p.npi)) : currentRows;
    let csv = '';
    let filename = '';
    if (currentSocialTab === 'meta') {
      csv = 'email,phone,fn,ln,ct,st,zip,country\n';
      data.forEach(p => {
        csv += `"${p.email || ''}","${(p.phone||'').replace(/[^0-9]/g,'')}","${p.first_name||''}","${p.last_name||''}","${p.city||''}","${p.state||''}","${p.zip||''}","US"\n`;
      });
      filename = `audiencia_meta_ads_${data.length}leads.csv`;
    } else {
      csv = 'Nombre,Telefono,WhatsApp_Link,Especialidad,Ciudad,Estado\n';
      data.forEach(p => {
        const ph = (p.phone||'').replace(/[^0-9]/g,'');
        csv += `"${p.name||''}","+1${ph}","https://wa.me/1${ph}","${p.specialty||''}","${p.city||''}","${p.state||''}"\n`;
      });
      filename = `audiencia_social_${data.length}leads.csv`;
    }
    triggerDownload(new Blob([csv], {type:'text/csv;charset=utf-8;'}), filename);
    closeSocialAdsModal();
  }

  function openEmailModal() { document.getElementById('emailCampaignModal').style.display = 'flex'; }
  function closeEmailModal() { document.getElementById('emailCampaignModal').style.display = 'none'; }
  function copyEmailTemplate() {
    navigator.clipboard.writeText(document.getElementById('emailTemplateText').value);
    alert('¡Plantilla comercial copiada al portapapeles!');
  }
  function downloadEmailBatch() {
    const data = currentRows.slice(0, 150);
    let csv = 'email,name,specialty,city,state,quintile\n';
    data.forEach(p => {
      csv += `"${p.email || ''}","${p.name||''}","${p.specialty||''}","${p.city||''}","${p.state||''}","Q${p.income_quintile||3}"\n`;
    });
    triggerDownload(new Blob([csv], {type:'text/csv;charset=utf-8;'}), `lote_email_marketing_150leads.csv`);
    closeEmailModal();
  }

  function openExportModal() { document.getElementById('exportModal').style.display = 'flex'; }
  function closeExportModal() { document.getElementById('exportModal').style.display = 'none'; }
  function executeStandardExport() {
    const opt = document.querySelector('input[name="exportOption"]:checked').value;
    const data = (opt === 'selected' && selectedNpis.size > 0) ? currentRows.filter(p => selectedNpis.has(p.npi)) : currentRows;
    let csv = 'NPI,Nombre,Especialidad,Credenciales,Ciudad,Estado,ZIP,Telefono,Email,Quintil,Es_Latino\n';
    data.forEach(p => {
      csv += `"${p.npi}","${p.name}","${p.specialty}","${p.credentials||''}","${p.city||''}","${p.state||''}","${p.zip||''}","${p.phone||''}","${p.email||''}","Q${p.income_quintile||3}","${p.is_latino?'Si':'No'}"\n`;
    });
    triggerDownload(new Blob([csv], {type:'text/csv;charset=utf-8;'}), `export_leads_ciasa_${data.length}.csv`);
    closeExportModal();
  }

  function triggerDownload(blob, filename) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  /* ==========================================================================
     MÓDULO DE IMPORTACIÓN INTELIGENTE DE REDES SOCIALES (CON DOBLE CONFIRMACIÓN)
     ========================================================================== */
  let analyzedSocialUpdates = [];

  function openSocialImportModal() {
    document.getElementById('socialImportModal').style.display = 'flex';
    document.getElementById('importStep1').style.display = 'block';
    document.getElementById('importStep2').style.display = 'none';
    document.getElementById('socialImportProgressWrap').style.display = 'none';
    document.getElementById('btnExecuteSocialSync').disabled = true;
    document.getElementById('doubleConfirmCheck').checked = false;
    document.getElementById('socialCsvFileInput').value = '';
    analyzedSocialUpdates = [];
  }

  function closeSocialImportModal() {
    document.getElementById('socialImportModal').style.display = 'none';
  }

  function toggleConfirmButton(isChecked) {
    const btn = document.getElementById('btnExecuteSocialSync');
    const selectedCount = analyzedSocialUpdates.filter(u => u.selected).length;
    btn.disabled = (!isChecked || selectedCount === 0);
  }

  function handleSocialCSVSelected(e) {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(evt) {
      const text = evt.target.result;
      analyzeSocialCSV(text);
    };
    reader.readAsText(file);
  }

  function normalizeName(str) {
    return (str || '')
      .toLowerCase()
      .replace(/dr\(a\)\.?|dra?\.?/g, '')
      .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]/g, ' ')
      .trim();
  }

  function analyzeSocialCSV(csvText) {
    const lines = csvText.split(/\r\n|\n/).map(l => l.trim()).filter(l => l.length > 0);
    if (lines.length < 2) {
      alert('El archivo CSV está vacío o no contiene filas válidas.');
      return;
    }

    const firstLine = lines[0];
    let delimiter = ',';
    if (firstLine.includes(';') && !firstLine.includes(',')) delimiter = ';';
    else if (firstLine.includes('\t')) delimiter = '\t';

    const headers = splitCSVLine(firstLine, delimiter).map(h => h.toLowerCase().replace(/[^a-z0-9_]/g, '_'));
    
    // Dataset completo en memoria para matching
    const allDbLeads = window.CURATED_NPI_LEADS || [];
    const npiMap = new Map();
    allDbLeads.forEach(l => npiMap.set(String(l.npi).trim(), l));

    let exactMatches = 0;
    let suggestedMatches = 0;
    let noMatches = 0;
    analyzedSocialUpdates = [];

    for (let i = 1; i < lines.length; i++) {
      const values = splitCSVLine(lines[i], delimiter);
      if (values.length < 2) continue;

      const row = {};
      headers.forEach((h, idx) => {
        const val = (values[idx] || '').trim();
        if (h.includes('npi')) row.npi = val;
        else if (h.includes('nombre') || h.includes('provider') || h.includes('name')) row.name = val;
        else if (h.includes('first_name') || h === 'fn') row.first_name = val;
        else if (h.includes('last_name') || h === 'ln') row.last_name = val;
        else if (h.includes('mail') || h.includes('correo') || h === 'email') row.email = val;
        else if (h.includes('linkedin') || h.includes('li_url')) row.linkedin_url = val;
        else if (h.includes('facebook') || h.includes('fb_url')) row.facebook_url = val;
        else if (h.includes('instagram') || h.includes('ig_url')) row.instagram_url = val;
        else if (h.includes('twitter') || h.includes('x_url')) row.twitter_url = val;
        else if (h.includes('web') || h.includes('site')) row.website_url = val;
        else if (h.includes('city') || h.includes('ciudad')) row.city = val;
      });

      // Solo procesar si tiene alguna red social o correo real verificado para aportar
      const hasSocialInfo = row.linkedin_url || row.facebook_url || row.instagram_url || row.twitter_url || row.website_url || row.email;
      if (!hasSocialInfo) continue;

      let matchedLead = null;
      let matchType = 'none';

      // 1. Intento por NPI exacto
      if (row.npi && npiMap.has(String(row.npi).trim())) {
        matchedLead = npiMap.get(String(row.npi).trim());
        matchType = 'exact';
        exactMatches++;
      } else {
        // 2. Intento de Matching Inteligente / Sugerido por Nombre y Ciudad
        const rowNormName = normalizeName(row.name || `${row.first_name || ''} ${row.last_name || ''}`);
        if (rowNormName.length > 3) {
          const found = allDbLeads.find(dbLead => {
            const dbNorm = normalizeName(dbLead.name || `${dbLead.first_name || ''} ${dbLead.last_name || ''}`);
            if (dbNorm.includes(rowNormName) || rowNormName.includes(dbNorm)) {
              if (row.city && dbLead.city) {
                return row.city.toLowerCase() === dbLead.city.toLowerCase();
              }
              return true;
            }
            return false;
          });

          if (found) {
            matchedLead = found;
            matchType = 'suggested';
            suggestedMatches++;
          } else {
            matchType = 'none';
            noMatches++;
          }
        } else {
          matchType = 'none';
          noMatches++;
        }
      }

      analyzedSocialUpdates.push({
        id: i,
        selected: (matchType !== 'none'),
        matchType,
        csvRow: row,
        dbLead: matchedLead,
        targetNpi: matchedLead ? matchedLead.npi : (row.npi || null),
        linkedin_url: row.linkedin_url || '',
        facebook_url: row.facebook_url || '',
        instagram_url: row.instagram_url || '',
        twitter_url: row.twitter_url || '',
        website_url: row.website_url || ''
      });
    }

    // Actualizar Contadores UI
    document.getElementById('countExactMatches').textContent = exactMatches.toLocaleString();
    document.getElementById('countSuggestedMatches').textContent = suggestedMatches.toLocaleString();
    document.getElementById('countNoMatches').textContent = noMatches.toLocaleString();

    // Renderizar Tabla de Revisión
    renderSocialPreviewTable();

    document.getElementById('importStep1').style.display = 'none';
    document.getElementById('importStep2').style.display = 'block';
  }

  function splitCSVLine(line, delimiter) {
    const result = [];
    let cur = '';
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
      const c = line[i];
      if (c === '"' || c === "'") inQuotes = !inQuotes;
      else if (c === delimiter && !inQuotes) {
        result.push(cur.replace(/^["']|["']$/g, '').trim());
        cur = '';
      } else {
        cur += c;
      }
    }
    result.push(cur.replace(/^["']|["']$/g, '').trim());
    return result;
  }

  function renderSocialPreviewTable() {
    const tbody = document.getElementById('importPreviewTableBody');
    if (analyzedSocialUpdates.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:20px; color:#94A3B8;">No se encontraron filas con enlaces de redes sociales en el archivo.</td></tr>';
      return;
    }

    let html = '';
    analyzedSocialUpdates.forEach((item, idx) => {
      const csvName = item.csvRow.name || `${item.csvRow.first_name || ''} ${item.csvRow.last_name || ''}` || 'Sin Nombre';
      const csvCity = item.csvRow.city ? ` (${item.csvRow.city})` : '';

      let dbInfo = '—';
      let badge = '';

      if (item.matchType === 'exact') {
        badge = '<span style="background:#DCFCE7; color:#15803D; padding:2px 6px; border-radius:4px; font-weight:800; font-size:0.68rem;"><i class="fa-solid fa-check"></i> Exacto (NPI)</span>';
        dbInfo = `<strong>${item.dbLead.name}</strong> <span style="color:#64748B;">[NPI: ${item.dbLead.npi}]</span>`;
      } else if (item.matchType === 'suggested') {
        badge = '<span style="background:#FEF3C7; color:#B45309; padding:2px 6px; border-radius:4px; font-weight:800; font-size:0.68rem;"><i class="fa-solid fa-wand-magic-sparkles"></i> Sugerido</span>';
        dbInfo = `<strong>${item.dbLead.name}</strong> <span style="color:#64748B;">[NPI: ${item.dbLead.npi} · ${item.dbLead.city || ''}]</span>`;
      } else {
        badge = '<span style="background:#F1F5F9; color:#64748B; padding:2px 6px; border-radius:4px; font-weight:700; font-size:0.68rem;">Sin Match</span>';
        dbInfo = '<span style="color:#94A3B8;">No encontrado en BD</span>';
      }

      let socialBadges = [];
      if (item.linkedin_url) socialBadges.push('<span style="color:#0A66C2;"><i class="fa-brands fa-linkedin"></i></span>');
      if (item.facebook_url) socialBadges.push('<span style="color:#1877F2;"><i class="fa-brands fa-facebook"></i></span>');
      if (item.instagram_url) socialBadges.push('<span style="color:#E1306C;"><i class="fa-brands fa-instagram"></i></span>');
      if (item.website_url) socialBadges.push('<span style="color:#0D9488;"><i class="fa-solid fa-globe"></i></span>');

      const isChecked = item.selected ? 'checked' : '';
      const isDisabled = (item.matchType === 'none') ? 'disabled' : '';

      html += `
        <tr style="border-bottom: 1px solid #F1F5F9; background: ${item.matchType === 'suggested' ? '#FFFDF5' : '#FFFFFF'};">
          <td style="text-align: center; padding: 6px 10px;">
            <input type="checkbox" ${isChecked} ${isDisabled} onchange="analyzedSocialUpdates[${idx}].selected = this.checked; toggleConfirmButton(document.getElementById('doubleConfirmCheck').checked);">
          </td>
          <td style="padding: 6px 10px;"><strong>${csvName}</strong>${csvCity}</td>
          <td style="padding: 6px 10px;">${dbInfo}</td>
          <td style="padding: 6px 10px;"><div style="display:flex; gap:6px; font-size:0.9rem;">${socialBadges.join('')}</div></td>
          <td style="padding: 6px 10px; text-align: center;">${badge}</td>
        </tr>
      `;
    });
    tbody.innerHTML = html;
  }

  async function executeSocialEnrichment() {
    const validUpdates = analyzedSocialUpdates.filter(u => u.selected && u.targetNpi);
    if (validUpdates.length === 0) {
      alert('No has seleccionado ningún médico válido para actualizar.');
      return;
    }

    const isDoubleConfirmed = document.getElementById('doubleConfirmCheck').checked;
    if (!isDoubleConfirmed) {
      alert('Por favor marca la casilla de Doble Confirmación para proceder con la actualización.');
      return;
    }

    const btn = document.getElementById('btnExecuteSocialSync');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Guardando Redes en BD...';

    const progressWrap = document.getElementById('socialImportProgressWrap');
    const progressBar = document.getElementById('socialImportProgressBar');
    const progressPercent = document.getElementById('socialImportProgressPercent');
    progressWrap.style.display = 'block';
    progressBar.style.width = '30%';
    progressPercent.textContent = '30%';

    try {
      const payload = validUpdates.map(u => ({
        npi: u.targetNpi,
        linkedin_url: u.linkedin_url,
        facebook_url: u.facebook_url,
        instagram_url: u.instagram_url,
        twitter_url: u.twitter_url,
        website_url: u.website_url
      }));

      const res = await fetch('/api/npi/sync_socials', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ updates: payload })
      });

      progressBar.style.width = '100%';
      progressPercent.textContent = '100%';

      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Error al guardar');

      // Actualizar también el dataset local en memoria de la pestaña activa
      const allDbLeads = window.CURATED_NPI_LEADS || [];
      const mapPayload = new Map();
      payload.forEach(p => mapPayload.set(String(p.npi), p));

      allDbLeads.forEach(l => {
        const u = mapPayload.get(String(l.npi));
        if (u) {
          if (u.linkedin_url) l.linkedin_url = u.linkedin_url;
          if (u.facebook_url) l.facebook_url = u.facebook_url;
          if (u.instagram_url) l.instagram_url = u.instagram_url;
          if (u.website_url) l.website_url = u.website_url;
        }
      });

      alert(`¡Éxito! Se enriquecieron correctamente las redes sociales de ${data.updatedCount} médicos sin alterar ninguna otra información.`);
      closeSocialImportModal();
      fetchLeads(); // Refrescar tabla en vivo

    } catch (err) {
      alert('Ocurrió un error al actualizar los datos: ' + err.message);
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-bolt"></i> Reintentar';
    }
  }
</script>

