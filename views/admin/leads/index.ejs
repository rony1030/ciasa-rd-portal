<style>
  .deal-step-pill {
    padding: 6px 12px;
    font-size: 0.76rem;
    font-weight: 700;
    color: #64748B;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.15s ease;
  }
  .deal-step-pill.active {
    background: #4F46E5;
    color: #FFFFFF;
    border-color: #4F46E5;
  }
</style>

<script>
  // Abrir Modal Especial de Negociación / Deal
  function openDealPreviewModal(leadId, leadName, projectName, monto, asesor, etapa) {
    document.getElementById('dealModalLeadName').textContent = leadName || 'Negociación Inmobiliaria';
    document.getElementById('dealModalProjectName').textContent = projectName || 'Proyecto CONFOTUR';
    document.getElementById('dealModalMonto').textContent = monto || '$185,000 USD';
    document.getElementById('dealModalAsesor').textContent = asesor || 'Paola Caram';
    document.getElementById('dealModalProjectBadge').textContent = projectName || 'CONFOTUR';
    document.getElementById('dealModalOpenLeadLink').href = `/admin/leads/${leadId}`;

    // Actualizar paso activo
    document.querySelectorAll('.deal-step-pill').forEach(el => el.classList.remove('active'));
    const stepEl = document.getElementById(`dealStep-${etapa}`) || document.getElementById('dealStep-nuevo');
    if (stepEl) stepEl.classList.add('active');

    document.getElementById('dealPreviewModal').style.display = 'flex';
  }

  function closeDealPreviewModal() {
    document.getElementById('dealPreviewModal').style.display = 'none';
  }
</script>

