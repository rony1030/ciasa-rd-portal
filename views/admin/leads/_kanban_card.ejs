<%
  const leadId = lead._id || lead.id || 'lead_' + Math.random().toString(36).substr(2, 9);
  const searchStr = `${lead.nombre || ''} ${lead.email || ''} ${lead.telefono || ''} ${lead.proyectoInteres || ''} ${lead.ciudad || ''} ${lead.pais || ''}`.toLowerCase();
  
  let montoNum = Number(String(lead.montoInversion || '').replace(/[^0-9.]/g, ''));
  if (isNaN(montoNum) || montoNum <= 0) montoNum = 185000;
  const monto = '$' + montoNum.toLocaleString('en-US') + ' USD';
  const fecha = lead.createdAt ? new Date(lead.createdAt).toLocaleDateString('es-DO', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Hoy';
  const asesor = lead.asesorAsignado || 'Paola Caram';
  const etapa = (lead.statusVentas || 'nuevo').toLowerCase();
  
  // Extraer iniciales para el avatar
  const initials = (lead.nombre || 'Lead')
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map(w => w[0].toUpperCase())
    .join('');
    
  const colorsList = ['#EFF6FF', '#FDF2F8', '#F0FDF4', '#FAF5FF', '#FFFBEB'];
  const textColors = ['#2563EB', '#DB2777', '#16A34A', '#9333EA', '#D97706'];
  const charCode = (lead.nombre || 'L').charCodeAt(0) || 0;
  const bgCol = colorsList[charCode % colorsList.length];
  const txtCol = textColors[charCode % textColors.length];
%>
<div class="kanban-card" id="kanban-card-<%= leadId %>" draggable="true" ondragstart="handleDragStart(event, '<%= leadId %>')" ondragend="handleDragEnd(event)" data-search="<%= searchStr %>" onclick="handleCardClick(event, '<%= leadId %>', '<%= (lead.nombre || 'Inversionista').replace(/'/g, "\\'") %>', '<%= (lead.proyectoInteres || 'CONFOTUR').replace(/'/g, "\\'") %>', '<%= monto %>', '<%= asesor %>', '<%= etapa %>')">
  
  <!-- Encabezado de la Tarjeta: Avatar + Nombre + Botón Ficha -->
  <div class="kc-header">
    <div class="kc-user-info">
      <div class="kc-avatar" style="background: <%= bgCol %>; color: <%= txtCol %>; border-color: <%= bgCol %>;">
        <%= initials %>
      </div>
      <div style="min-width: 0;">
        <div class="kc-name" title="<%= lead.nombre || 'Prospecto' %>"><%= lead.nombre || 'Prospecto' %></div>
        <div class="kc-origin">
          <i class="fa-solid fa-location-dot" style="font-size: 0.65rem; color: #94A3B8;"></i>
          <span><%= [lead.ciudad, lead.pais].filter(Boolean).join(', ') || 'Diáspora EE.UU.' %></span>
        </div>
      </div>
    </div>
    <a href="/admin/leads/<%= leadId %>" class="kc-link-btn" title="Abrir Ficha 360°" onclick="event.stopPropagation();">
      <i class="fa-solid fa-arrow-up-right-from-square"></i>
    </a>
  </div>

  <!-- Tags: Proyecto de Interés + WhatsApp -->
  <div class="kc-tags">
    <span class="kc-tag-project" title="<%= lead.proyectoInteres || 'CONFOTUR' %>">
      <i class="fa-solid fa-building"></i>
      <span><%= lead.proyectoInteres || 'CONFOTUR' %></span>
    </span>
    <% if (lead.telefono) { %>
      <a href="https://wa.me/<%= lead.telefono.replace(/[^0-9]/g, '') %>?text=Hola%20<%= encodeURIComponent(lead.nombre || '') %>,%20le%20escribimos%20de%20CIASA%20Bolsa%20Inmobiliaria." target="_blank" class="kc-tag-wa" title="Escribir por WhatsApp" onclick="event.stopPropagation();">
        <i class="fa-brands fa-whatsapp"></i> Chat
      </a>
    <% } %>
  </div>

  <!-- Footer: Precio, Fecha y Asesor -->
  <div class="kc-footer">
    <div class="kc-price"><%= monto %></div>
    <div class="kc-meta" style="display: flex; align-items: center; gap: 6px;">
      <span style="background: #F1F5F9; color: #475569; padding: 1px 6px; border-radius: 4px; font-size: 0.65rem; font-weight: 700;">
        <i class="fa-solid fa-user-tie" style="font-size: 0.60rem; color: #2563EB;"></i> <%= asesor.split(' ')[0] %>
      </span>
      <span><%= fecha %></span>
    </div>
  </div>

</div>
