<%
  const leadId = lead._id || lead.id || 'lead_' + Math.random().toString(36).substr(2, 9);
  const searchStr = `${lead.nombre || ''} ${lead.email || ''} ${lead.telefono || ''} ${lead.proyectoInteres || ''} ${lead.ciudad || ''} ${lead.pais || ''}`.toLowerCase();
  const monto = lead.montoInversion ? ('$' + parseInt(lead.montoInversion).toLocaleString('en-US')) : '$180,000';
  const fecha = lead.createdAt ? new Date(lead.createdAt).toLocaleDateString('es-DO', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Hoy';
%>
<div class="kanban-card" id="kanban-card-<%= leadId %>" draggable="true" ondragstart="handleDragStart(event, '<%= leadId %>')" ondragend="handleDragEnd(event)" data-search="<%= searchStr %>">
  
  <div class="kanban-card-title">
    <span><i class="fa-solid fa-cube" style="font-size: 0.76rem; color: #6366F1; margin-right: 6px;"></i> <%= lead.nombre || 'Prospecto' %></span>
    <a href="/admin/leads/<%= leadId %>" style="color: #94A3B8; font-size: 0.8rem;" title="Abrir Ficha"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
  </div>

  <div class="kanban-card-info-row">
    <i class="fa-regular fa-user" style="color: #94A3B8;"></i>
    <span style="font-weight: 600;"><%= [lead.ciudad, lead.pais].filter(Boolean).join(', ') || 'Diáspora EE.UU.' %></span>
  </div>

  <div style="display: flex; gap: 6px; margin: 8px 0; flex-wrap: wrap;">
    <span class="kanban-pill" style="background: #EEF2FF; color: #4F46E5; border-color: #C7D2FE;">
      <i class="fa-solid fa-briefcase" style="font-size: 0.68rem;"></i> <%= lead.proyectoInteres || 'CONFOTUR' %>
    </span>
    <% if (lead.telefono) { %>
      <a href="https://wa.me/<%= lead.telefono.replace(/[^0-9]/g, '') %>?text=Hola%20<%= encodeURIComponent(lead.nombre || '') %>,%20le%20escribimos%20de%20CIASA%20Bolsa%20Inmobiliaria." target="_blank" class="kanban-pill" style="background: #ECFDF5; color: #047857; border-color: #A7F3D0; text-decoration: none;">
        <i class="fa-brands fa-whatsapp"></i> Chat
      </a>
    <% } %>
  </div>

  <div class="kanban-card-footer">
    <div class="kanban-price">
      <i class="fa-solid fa-dollar-sign" style="font-size: 0.78rem;"></i> <%= monto %>
    </div>
    <div style="color: #94A3B8; font-size: 0.74rem; font-weight: 600;">
      <i class="fa-regular fa-calendar" style="margin-right: 2px;"></i> <%= fecha %>
    </div>
  </div>

</div>
