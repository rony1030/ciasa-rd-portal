<%- include('../layout', { pageTitle: 'Registrar Nuevo Inversionista', activePage: 'leads-nuevo' }) %>

<style>
  .lead-form-container {
    width: 100%;
    margin-bottom: 40px;
  }

  .form-section-card {
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    margin-bottom: 20px;
  }

  .form-section-header {
    padding: 16px 24px;
    background: #FAFAFC;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .form-section-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #F0FDF4;
    color: #16A34A;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
  }
  .form-section-title {
    font-size: 0.90rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-heading);
    margin: 0;
  }
  .form-section-subtitle {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-top: 1px;
  }

  .form-section-body {
    padding: 24px;
  }

  .input-with-icon {
    position: relative;
  }
  .input-with-icon i {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #94A3B8;
    font-size: 0.88rem;
    pointer-events: none;
  }
  .input-with-icon .form-input {
    padding-left: 40px;
  }

  .currency-input-wrap {
    position: relative;
  }
  .currency-prefix {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--primary);
    font-weight: 800;
    font-size: 0.95rem;
    pointer-events: none;
  }
  .currency-input-wrap .form-input {
    padding-left: 32px;
    font-weight: 700;
    color: var(--secondary);
  }
</style>

<div class="lead-form-container">
  
  <!-- Encabezado de Página -->
  <div class="section-header" style="margin-bottom: 20px;">
    <div>
      <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--text-heading); margin-bottom: 2px;">
        <i class="fa-solid fa-user-plus" style="color: var(--primary); margin-right: 6px;"></i> Registrar Nuevo Prospecto
      </h2>
      <p style="font-size: 0.84rem; color: var(--text-muted);">Ingresa la información comercial y perfil del inversionista para iniciar seguimiento</p>
    </div>
    <a href="/admin/leads" class="btn btn-secondary btn-sm">
      <i class="fa-solid fa-arrow-left"></i> Volver a Leads
    </a>
  </div>

  <% if (error) { %>
  <div class="alert alert-error" style="margin-bottom: 18px;"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
  <% } %>

  <form method="POST" action="/admin/leads/nuevo">
    
    <!-- 1. IDENTIDAD & DATOS DE CONTACTO -->
    <div class="form-section-card">
      <div class="form-section-header">
        <div class="form-section-icon"><i class="fa-solid fa-address-card"></i></div>
        <div>
          <div class="form-section-title">1. Identidad & Datos de Contacto</div>
          <div class="form-section-subtitle">Nombre, correo electrónico, teléfono móvil y país de residencia</div>
        </div>
      </div>
      
      <div class="form-section-body">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Nombre Completo *</label>
            <div class="input-with-icon">
              <i class="fa-regular fa-user"></i>
              <input type="text" name="nombre" class="form-input" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Correo Electrónico *</label>
            <div class="input-with-icon">
              <i class="fa-regular fa-envelope"></i>
              <input type="email" name="email" class="form-input" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Teléfono / WhatsApp *</label>
            <div class="input-with-icon">
              <i class="fa-brands fa-whatsapp" style="color: #25D366;"></i>
              <input type="tel" name="telefono" class="form-input" required>
            </div>
          </div>

          <!-- Dropdown Personalizado: País -->
          <div class="form-group">
            <label class="form-label">País de Residencia</label>
            <div class="custom-dropdown-wrap" id="paisDropdownWrap">
              <div class="custom-dropdown-trigger" onclick="toggleAdminDropdown('paisDropdownWrap')">
                <span id="paisSelectedLabel">Estados Unidos (Diáspora)</span>
                <i class="fa-solid fa-chevron-down chevron-icon"></i>
              </div>
              <div class="custom-dropdown-menu">
                <div class="custom-dropdown-item selected" onclick="selectAdminOption('paisInput', 'United States', 'Estados Unidos (Diáspora)', 'paisSelectedLabel', 'paisDropdownWrap')">
                  <span>Estados Unidos (Diáspora)</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('paisInput', 'Dominican Republic', 'República Dominicana', 'paisSelectedLabel', 'paisDropdownWrap')">
                  <span>República Dominicana</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('paisInput', 'Puerto Rico', 'Puerto Rico', 'paisSelectedLabel', 'paisDropdownWrap')">
                  <span>Puerto Rico</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('paisInput', 'Spain', 'España / Europa', 'paisSelectedLabel', 'paisDropdownWrap')">
                  <span>España / Europa</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('paisInput', 'Canada', 'Canadá', 'paisSelectedLabel', 'paisDropdownWrap')">
                  <span>Canadá</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('paisInput', 'Other', 'Otro País', 'paisSelectedLabel', 'paisDropdownWrap')">
                  <span>Otro País</span>
                </div>
              </div>
              <input type="hidden" name="pais" id="paisInput" value="United States">
            </div>
          </div>

          <div class="form-group full">
            <label class="form-label">Ciudad / Estado</label>
            <div class="input-with-icon">
              <i class="fa-solid fa-location-dot"></i>
              <input type="text" name="ciudad" class="form-input">
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. PERFIL DE INVERSIÓN & ASIGNACIÓN COMERCIAL -->
    <div class="form-section-card">
      <div class="form-section-header">
        <div class="form-section-icon" style="background: #EFF6FF; color: #2563EB;"><i class="fa-solid fa-chart-pie"></i></div>
        <div>
          <div class="form-section-title">2. Perfil Comercial & Inversión</div>
          <div class="form-section-subtitle">Presupuesto en dólares, proyecto de preferencia y canal de adquisición</div>
        </div>
      </div>

      <div class="form-section-body">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Presupuesto Estimado (USD)</label>
            <div class="currency-input-wrap">
              <span class="currency-prefix">$</span>
              <input type="number" name="montoInversion" class="form-input" min="0" step="5000">
            </div>
          </div>

          <!-- Dropdown Personalizado: Proyecto -->
          <div class="form-group">
            <label class="form-label">Proyecto Inmobiliario de Interés</label>
            <div class="custom-dropdown-wrap" id="leadProjDropdownWrap">
              <div class="custom-dropdown-trigger" onclick="toggleAdminDropdown('leadProjDropdownWrap')">
                <span id="leadProjSelectedLabel">-- Seleccionar Proyecto del Catálogo --</span>
                <i class="fa-solid fa-chevron-down chevron-icon"></i>
              </div>
              <div class="custom-dropdown-menu">
                <div class="custom-dropdown-item selected" onclick="selectAdminOption('leadProjInput', '', '-- Seleccionar Proyecto del Catálogo --', 'leadProjSelectedLabel', 'leadProjDropdownWrap')">
                  <span>-- Seleccionar Proyecto del Catálogo --</span>
                </div>
                <% projects.forEach(p => { %>
                  <div class="custom-dropdown-item" onclick="selectAdminOption('leadProjInput', '<%= p.code %> - <%= p.name %>', '<%= p.code %> — <%= p.name %>', 'leadProjSelectedLabel', 'leadProjDropdownWrap')">
                    <span><%= p.code %> — <%= p.name %></span>
                  </div>
                <% }) %>
              </div>
              <input type="hidden" name="proyectoInteres" id="leadProjInput" value="">
            </div>
          </div>

          <!-- Dropdown Personalizado: Origen -->
          <div class="form-group">
            <label class="form-label">Origen / Canal de Captación</label>
            <div class="custom-dropdown-wrap" id="sourceDropdownWrap">
              <div class="custom-dropdown-trigger" onclick="toggleAdminDropdown('sourceDropdownWrap')">
                <span id="sourceSelectedLabel">Registro Manual en Oficina</span>
                <i class="fa-solid fa-chevron-down chevron-icon"></i>
              </div>
              <div class="custom-dropdown-menu">
                <div class="custom-dropdown-item selected" onclick="selectAdminOption('sourceInput', 'admin-manual', 'Registro Manual en Oficina', 'sourceSelectedLabel', 'sourceDropdownWrap')">
                  <span>Registro Manual en Oficina</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('sourceInput', 'instagram-ad', 'Campaña Instagram Ads (Diáspora)', 'sourceSelectedLabel', 'sourceDropdownWrap')">
                  <span>Campaña Instagram Ads (Diáspora)</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('sourceInput', 'facebook-ad', 'Facebook Ads Leads', 'sourceSelectedLabel', 'sourceDropdownWrap')">
                  <span>Facebook Ads Leads</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('sourceInput', 'referido', 'Referido por Inversionista', 'sourceSelectedLabel', 'sourceDropdownWrap')">
                  <span>Referido por Inversionista</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('sourceInput', 'proyecto', 'Formulario Web Portal', 'sourceSelectedLabel', 'sourceDropdownWrap')">
                  <span>Formulario Web Portal</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('sourceInput', 'whatsapp', 'Chat Directo WhatsApp', 'sourceSelectedLabel', 'sourceDropdownWrap')">
                  <span>Chat Directo WhatsApp</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('sourceInput', 'evento', 'Feria Inmobiliaria / Expo', 'sourceSelectedLabel', 'sourceDropdownWrap')">
                  <span>Feria Inmobiliaria / Expo</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('sourceInput', 'npi', 'Base Médicos / NPI', 'sourceSelectedLabel', 'sourceDropdownWrap')">
                  <span>Base Médicos / NPI</span>
                </div>
              </div>
              <input type="hidden" name="source" id="sourceInput" value="admin-manual">
            </div>
          </div>

          <!-- Dropdown Personalizado: Estado Inicial -->
          <div class="form-group">
            <label class="form-label">Estado Inicial en Pipeline</label>
            <div class="custom-dropdown-wrap" id="leadStatusDropdownWrap">
              <div class="custom-dropdown-trigger" onclick="toggleAdminDropdown('leadStatusDropdownWrap')">
                <span id="leadStatusSelectedLabel">Nuevo (Sin contactar)</span>
                <i class="fa-solid fa-chevron-down chevron-icon"></i>
              </div>
              <div class="custom-dropdown-menu">
                <div class="custom-dropdown-item selected" onclick="selectAdminOption('leadStatusInput', 'nuevo', 'Nuevo (Sin contactar)', 'leadStatusSelectedLabel', 'leadStatusDropdownWrap')">
                  <span>Nuevo (Sin contactar)</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('leadStatusInput', 'contactado', 'Contactado (En seguimiento)', 'leadStatusSelectedLabel', 'leadStatusDropdownWrap')">
                  <span>Contactado (En seguimiento)</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('leadStatusInput', 'calificado', 'Calificado (Presupuesto validado)', 'leadStatusSelectedLabel', 'leadStatusDropdownWrap')">
                  <span>Calificado (Presupuesto validado)</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('leadStatusInput', 'negociacion', 'En Negociación / Separación', 'leadStatusSelectedLabel', 'leadStatusDropdownWrap')">
                  <span>En Negociación / Separación</span>
                </div>
                <div class="custom-dropdown-item" onclick="selectAdminOption('leadStatusInput', 'cerrado', 'Cierre Ganado', 'leadStatusSelectedLabel', 'leadStatusDropdownWrap')">
                  <span>Cierre Ganado</span>
                </div>
              </div>
              <input type="hidden" name="statusVentas" id="leadStatusInput" value="nuevo">
            </div>
          </div>

          <div class="form-group full">
            <label class="form-label">Notas Iniciales de la Conversación / Requerimientos</label>
            <textarea name="notas" class="form-input" rows="3"></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- BOTONES DE ACCIÓN FLUIDOS -->
    <div style="display: flex; gap: 12px; justify-content: flex-end; align-items: center;">
      <a href="/admin/leads" class="btn btn-secondary" style="padding: 10px 22px;">Cancelar</a>
      <button type="submit" class="btn btn-primary" style="padding: 11px 32px; font-size: 0.92rem; font-weight: 800;">
        <i class="fa-solid fa-cloud-arrow-up"></i> Guardar y Abrir Ficha 360°
      </button>
    </div>

  </form>

</div>

<%- include('../layout-end') %>
